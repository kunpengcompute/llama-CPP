+// #define LOAD_ZERO(acc) asm volatile("ld1w {%0.d}, %2/z, [%1]\n\t" : "=w"(acc) : "r"(zero_f32_x), "Upl"(pg_all) :);
+#define LOAD_ZERO(acc) (acc) = zero;
+            LOAD_ZERO(acc00);
+            LOAD_ZERO(acc01);
+            LOAD_ZERO(acc02);
+            LOAD_ZERO(acc03);
