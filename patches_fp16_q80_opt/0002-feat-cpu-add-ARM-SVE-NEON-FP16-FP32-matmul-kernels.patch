+    typedef void (*matmul_f)(size_t M, size_t N, int K,
+                            const void * GGML_RESTRICT x,
+                            const void * GGML_RESTRICT y,
+                            void * GGML_RESTRICT c,
+                            size_t c_column_bytes);
+
     struct ggml_type_traits_cpu {
         ggml_from_float_t        from_float;
         ggml_vec_dot_t           vec_dot;
         enum ggml_type           vec_dot_type;
         int64_t                  nrows; // number of rows to process simultaneously
+        bool                     is_matmul_valid;
+        matmul_f                 matmul;
     };
 
+    typedef struct matmul_outer_pack_t {
+        uint8_t* p;
+        size_t p_stride;
+        size_t sz_p;
+        size_t nr;
+        int dim;
+    } matmul_outer_pack_t;
