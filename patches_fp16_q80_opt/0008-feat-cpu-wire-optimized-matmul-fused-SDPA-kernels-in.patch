         .from_float               = quantize_row_q8_1,
@@ -1168,6 +1176,315 @@ void ggml_set_f32_nd(const struct ggml_tensor * tensor, int i0, int i1, int i2,
 
 // ggml_compute_forward_mul_mat
 
+void compute_forward_mul_mat_one_chunk_matmul_kernel(
+    const struct ggml_compute_params * params,
+    struct ggml_tensor * dst,
+    const enum ggml_type type,
+    const int64_t ir0_start,
+    const int64_t ir0_end,
+    const int64_t ir1_start,
+    const int64_t ir1_end) {
+
+    if (ir0_start >= ir0_end || ir1_start >= ir1_end) return;
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+
+    const int64_t K = src0->ne[0];
+
+    enum ggml_type const matmul_type = type_traits_cpu[type].vec_dot_type;
+
+    assert(type_traits_cpu[type].is_matmul_valid);
+    matmul_f matmul = type_traits_cpu[type].matmul;
+
+    // A[M, K], B[N, K], C[M, N]
+    const uint8_t* GGML_RESTRICT A = (const uint8_t*)(src0->data);
+    const uint8_t* GGML_RESTRICT B = (const uint8_t*)(src1->data);
+    if (matmul_type != src1->type) {
+        B = (const uint8_t*)(params->wdata);
+    }
+    uint8_t* GGML_RESTRICT C = (uint8_t*)(dst->data);
+    const size_t k_row_size = ggml_row_size(matmul_type, src1->ne[0]);
+    size_t byte_off_A = ir0_start * k_row_size;
+    size_t byte_off_B = ir1_start * k_row_size;
+    const int64_t M_th = ir0_end - ir0_start;
+    const int64_t N_th = ir1_end - ir1_start;
+    // Downgrade when has leftovers for outer kernels
+    int64_t M_th_outer = M_th & ~(16 - 1);
+    int64_t N_th_outer = N_th & ~(8 - 1);
+    // fprintf(stderr, "M_th=%d,N_th=%d\n", M_th,N_th);
+    // fprintf(stderr, "M_th_outer=%d,N_th_outer=%d\n", M_th_outer,N_th_outer);
+    if(matmul_type == GGML_TYPE_F16 || matmul_type == GGML_TYPE_F32) {
+        matmul_f leftovers_kernel;
+        switch (matmul_type) {
+            case GGML_TYPE_F16:
+                leftovers_kernel = ggml_matmul_f16_4x4_kernel;
+                break;
+            case GGML_TYPE_F32:
+                leftovers_kernel = ggml_matmul_f32_4x4_kernel;
+                break;
+            default:
+                GGML_ASSERT(false);
+        }
+        if(K % 8 == 0) {
+            if((M_th_outer != M_th || N_th_outer != N_th) && (type == GGML_TYPE_F16 || type == GGML_TYPE_F32)) {
+                void* GGML_RESTRICT ptr_C_matmul = &C[ir0_start * dst->nb[0] + ir1_start * dst->nb[1]];
+                void* GGML_RESTRICT ptr_C_leftovers_1 = &C[(ir0_start + M_th_outer) * dst->nb[0] + ir1_start * dst->nb[1]];
+                void* GGML_RESTRICT ptr_C_leftovers_2 = &C[ir0_start * dst->nb[0] + (ir1_start + N_th_outer) * dst->nb[1]];
+                size_t c_column_bytes = dst->nb[1];
+                if (M_th_outer > 0 && N_th_outer > 0) {
+                    matmul(M_th_outer, N_th_outer, K, A + byte_off_A, B + byte_off_B, ptr_C_matmul, c_column_bytes);
+                }
+                if(M_th - M_th_outer > 0) {
+                    leftovers_kernel(M_th - M_th_outer, N_th, K,
+                                    A + byte_off_A + (M_th_outer*k_row_size),
+                                    B+byte_off_B,
+                                    ptr_C_leftovers_1,
+                                    c_column_bytes);
+                }
+                if(N_th - N_th_outer > 0) {
+                    leftovers_kernel(M_th_outer, N_th - N_th_outer, K,
+                                    A + byte_off_A,
+                                    B+byte_off_B + (N_th_outer*k_row_size),
+                                    ptr_C_leftovers_2,
+                                    c_column_bytes);
+                }
+            } else {
+                matmul(M_th, N_th, K, A + byte_off_A, B + byte_off_B, &C[ir0_start * dst->nb[0] + ir1_start * dst->nb[1]], dst->nb[1]);
+            }
+        } else {
+            leftovers_kernel(M_th, N_th, K, A + byte_off_A, B + byte_off_B, &C[ir0_start * dst->nb[0] + ir1_start * dst->nb[1]], dst->nb[1]);
+        }
+    } else if (matmul_type == GGML_TYPE_Q8_0) {
+        void* GGML_RESTRICT ptr_C_matmul = &C[ir0_start * dst->nb[0] + ir1_start * dst->nb[1]];
+        size_t c_column_bytes = dst->nb[1];
+        // fprintf(stderr, "run matmul for GGML_TYPE_Q8_0\n");
+        matmul(M_th, N_th, K, A + byte_off_A, B + byte_off_B, ptr_C_matmul, c_column_bytes);
+    } else {
+        GGML_ASSERT(false);
+    }
+}
