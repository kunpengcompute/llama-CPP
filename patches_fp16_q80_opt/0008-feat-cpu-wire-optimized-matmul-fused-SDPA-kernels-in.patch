+static void ggml_compute_forward_fused_cpp_sdpa_ext_impl(
+        const float * q,
+        const float * k,
+        const float * v,
+        const float * mask_f32,
+        const uint16_t * mask_f16,
+              float * dst,
+        int64_t B, int64_t H, int64_t L, int64_t S, int64_t D, int64_t DV,
+        int64_t q_nb0, int64_t q_nb1, int64_t q_nb2, int64_t q_nb3,
+        int64_t k_nb0, int64_t k_nb1, int64_t k_nb2, int64_t k_nb3,
+        int64_t v_nb0, int64_t v_nb1, int64_t v_nb2, int64_t v_nb3,
+        int64_t o_nb0, int64_t o_nb1, int64_t o_nb2, int64_t o_nb3,
+        int64_t m_ne0, int64_t m_ne1, int64_t m_ne2, int64_t m_ne3,
+        int64_t m_nb0, int64_t m_nb1, int64_t m_nb2, int64_t m_nb3,
+        float scale) {
+    int ret = 0;
+    if (mask_f16 != nullptr) {
+        ret = fused_cpp_sdpa_flash2_neon_l3kv_packqkv_pbf16pv_fp32_llamacpp_mask_f16(
+                q, k, v, mask_f16, dst,
+                B, H, L, S, D, DV,
+                q_nb0, q_nb1, q_nb2, q_nb3,
+                k_nb0, k_nb1, k_nb2, k_nb3,
+                v_nb0, v_nb1, v_nb2, v_nb3,
+                o_nb0, o_nb1, o_nb2, o_nb3,
+                m_ne0, m_ne1, m_ne2, m_ne3,
+                m_nb0, m_nb1, m_nb2, m_nb3,
+                scale);
+    } else if (mask_f32 != nullptr) {
+        ret = fused_cpp_sdpa_flash2_neon_l3kv_packqkv_pbf16pv_fp32_llamacpp_mask_f32(
+                q, k, v, mask_f32, dst,
+                B, H, L, S, D, DV,
+                q_nb0, q_nb1, q_nb2, q_nb3,
+                k_nb0, k_nb1, k_nb2, k_nb3,
+                v_nb0, v_nb1, v_nb2, v_nb3,
+                o_nb0, o_nb1, o_nb2, o_nb3,
+                m_ne0, m_ne1, m_ne2, m_ne3,
+                m_nb0, m_nb1, m_nb2, m_nb3,
+                scale);
+    } else {
+        ret = fused_cpp_sdpa_flash2_neon_l3kv_packqkv_pbf16pv_fp32_llamacpp(
+                q, k, v, dst,
+                B, H, L, S, D, DV,
+                q_nb0, q_nb1, q_nb2, q_nb3,
+                k_nb0, k_nb1, k_nb2, k_nb3,
+                v_nb0, v_nb1, v_nb2, v_nb3,
+                o_nb0, o_nb1, o_nb2, o_nb3,
+                scale);
+    }
+    if (ret != 0) {
+        GGML_ABORT("fused_cpp fp32_packqkv sdpa failed with code %d", ret);
+    }
+}
