+void ggml_compute_forward_fused_cpp_sdpa_ext(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+#if defined(GGML_USE_FUSED_CPP_SDPA)
+    GGML_ASSERT(dst->op == GGML_OP_FUSED_CPP_SDPA_EXT);
+
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(k->type == GGML_TYPE_F32);
+    GGML_ASSERT(v->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(q->ne[0] == k->ne[0]);
+    GGML_ASSERT(k->ne[1] == v->ne[1]);
+    GGML_ASSERT(q->ne[2] == k->ne[2]);
+    GGML_ASSERT(q->ne[2] == v->ne[2]);
+    GGML_ASSERT(q->ne[3] == k->ne[3]);
+    GGML_ASSERT(q->ne[3] == v->ne[3]);
+    GGML_ASSERT(dst->ne[0] == v->ne[0]);
+    GGML_ASSERT(dst->ne[1] == q->ne[2]);
+    GGML_ASSERT(dst->ne[2] == q->ne[1]);
+    GGML_ASSERT(dst->ne[3] == q->ne[3]);
+    GGML_ASSERT(q->nb[0] == ggml_type_size(q->type));
+    GGML_ASSERT(dst->nb[0] == ggml_type_size(dst->type));
+
+    float scale;
+    memcpy(&scale, dst->op_params, sizeof(scale));
+
+    const int64_t B  = q->ne[3];
+    const int64_t H  = q->ne[2];
+    const int64_t L  = q->ne[1];
+    const int64_t S  = k->ne[1];
+    const int64_t D  = q->ne[0];
+    const int64_t DV = v->ne[0];
+
+    GGML_ASSERT((DV % 8) == 0);
+
+    const int n_task = params->nth;
+    const int ith    = params->ith;
+
+    // partition heads across threads
+    const int64_t h_per_task = (H + n_task - 1) / n_task;
+    const int64_t h_start    = ith * h_per_task;
+    const int64_t h_end      = MIN(h_start + h_per_task, H);
+
+    if (h_start >= h_end) {
+        return;
+    }
+
+    if (ggml_fused_cpp_sdpa_debug()) {
+        fprintf(stderr, "%s: executing fused_cpp SDPA: B=%lld H=%lld[%lld..%lld) L=%lld S=%lld D=%lld DV=%lld mask=%s ith=%d/%d\n",
+                __func__,
+                (long long) B, (long long) h_start, (long long) h_end,
+                (long long) L, (long long) S, (long long) D, (long long) DV,
+                mask == nullptr ? "none" : ggml_type_name(mask->type),
+                ith, n_task);
+    }
+
+    // offset data pointers to the start of this thread's head range
+    // q/k/v after permute(0,2,1,3) have shape [D, n_tokens, n_head, B];
+    //   nb[2] is the stride for the n_head dimension (= D*4)
+    // dst has shape [D, n_head, n_tokens, B];
+    //   nb[1] is the stride for the n_head dimension (= D*4)
+    const float * q_h = (const float *) q->data + h_start * (q->nb[2] / sizeof(float));
+    const float * k_h = (const float *) k->data + h_start * (k->nb[2] / sizeof(float));
+    const float * v_h = (const float *) v->data + h_start * (v->nb[2] / sizeof(float));
+          float * o_h = (      float *) dst->data + h_start * (dst->nb[1] / sizeof(float));
+
+    const int64_t H_th = h_end - h_start;
+
+    const uint16_t * mask_f16 = (mask != nullptr && mask->type == GGML_TYPE_F16) ? (const uint16_t *) mask->data : nullptr;
+    const float    * mask_f32 = (mask != nullptr && mask->type == GGML_TYPE_F32) ? (const float    *) mask->data : nullptr;
+
+    const int64_t BLK = 64;
+
+    /*
+    * 对角块 SDPA:
+    * 适用于 L == S 的 prompt processing 场景。
+    *
+    * 原始:
+    *   L x S
+    *
+    * 改后:
+    *   多个 64 x 64 对角块
+    *
+    * 注意：这不是严格等价优化，正确性后面需要验证。
+    */
+    if (L == S && L > BLK && (L % BLK) == 0) {
+        for (int64_t l0 = 0; l0 < L; l0 += BLK) {
+            const int64_t L_cur = BLK;
+            const int64_t S_cur = BLK;
+
+            const float * q_blk =
+                q_h + l0 * (q->nb[1] / sizeof(float));
+
+            const float * k_blk =
+                k_h + l0 * (k->nb[1] / sizeof(float));
+
+            const float * v_blk =
+                v_h + l0 * (v->nb[1] / sizeof(float));
+
+            float * o_blk =
+                o_h + l0 * (dst->nb[2] / sizeof(float));
+
+            const float * mask_f32_blk =
+                mask_f32 ?
+                mask_f32
+                    + l0 * (mask->nb[1] / sizeof(float))
+                    + l0 * (mask->nb[0] / sizeof(float))
+                : nullptr;
+
+            const uint16_t * mask_f16_blk =
+                mask_f16 ?
+                mask_f16
+                    + l0 * (mask->nb[1] / sizeof(uint16_t))
+                    + l0 * (mask->nb[0] / sizeof(uint16_t))
+                : nullptr;
+
+            ggml_compute_forward_fused_cpp_sdpa_ext_impl(
+                    q_blk, k_blk, v_blk, mask_f32_blk, mask_f16_blk, o_blk,
+                    B, H_th, L_cur, S_cur, D, DV,
+                    (int64_t) q->nb[0],   (int64_t) q->nb[1],   (int64_t) q->nb[2],   (int64_t) q->nb[3],
+                    (int64_t) k->nb[0],   (int64_t) k->nb[1],   (int64_t) k->nb[2],   (int64_t) k->nb[3],
+                    (int64_t) v->nb[0],   (int64_t) v->nb[1],   (int64_t) v->nb[2],   (int64_t) v->nb[3],
+                    (int64_t) dst->nb[0], (int64_t) dst->nb[1], (int64_t) dst->nb[2], (int64_t) dst->nb[3],
+
+                    mask ? S_cur       : 0,
+                    mask ? L_cur       : 0,
+                    mask ? mask->ne[2] : 0,
+                    mask ? mask->ne[3] : 0,
+                    mask ? mask->nb[0] : 0,
+                    mask ? mask->nb[1] : 0,
+                    mask ? mask->nb[2] : 0,
+                    mask ? mask->nb[3] : 0,
+                    scale);
+        }
+    } else {
+        ggml_compute_forward_fused_cpp_sdpa_ext_impl(
+                q_h, k_h, v_h, mask_f32, mask_f16, o_h,
+                B, H_th, L, S, D, DV,
+                (int64_t) q->nb[0],   (int64_t) q->nb[1],   (int64_t) q->nb[2],   (int64_t) q->nb[3],
+                (int64_t) k->nb[0],   (int64_t) k->nb[1],   (int64_t) k->nb[2],   (int64_t) k->nb[3],
+                (int64_t) v->nb[0],   (int64_t) v->nb[1],   (int64_t) v->nb[2],   (int64_t) v->nb[3],
+                (int64_t) dst->nb[0], (int64_t) dst->nb[1], (int64_t) dst->nb[2], (int64_t) dst->nb[3],
+                mask ? mask->ne[0] : 0,
+                mask ? mask->ne[1] : 0,
+                mask ? mask->ne[2] : 0,
+                mask ? mask->ne[3] : 0,
+                mask ? mask->nb[0] : 0,
+                mask ? mask->nb[1] : 0,
+                mask ? mask->nb[2] : 0,
+                mask ? mask->nb[3] : 0,
+                scale);
+    }
+
+#else
+    GGML_UNUSED(params);
+    GGML_UNUSED(dst);
+    GGML_ABORT("fused_cpp fp32_packqkv sdpa is not enabled in this build");
+#endif
+}
