From 76b5a66ffea772ed1613bf452b876879cb8fc8a9 Mon Sep 17 00:00:00 2001
From: Kaixin Liu <liukaixin1@h-partners.com>
Date: Thu, 6 Aug 2026 16:19:07 +0800
Subject: [PATCH 03/10] feat(cpu): add Q8_0 MMLA spack matmul kernels

- ggml-cpu-quants.h: declare matmul_q8_0_mmla_spack pack/run API,
  4x4/8x8 micro-kernels (+ neon variants) and masked kernel
- ggml-cpu-quants.c: implement packed Q8_0 matmul with s*i8mm mmla,
  pad-based driver (matmul_q8_0_mmla_spack_b), padded tile path and
  4x4-tiled padded entry; split the hot kernel into its own noinline
  function to avoid GCC ICE under heavy inlining
---
 ggml/src/ggml-cpu/ggml-cpu-quants.c | 1827 ++++++++++++++++++++++++++-
 ggml/src/ggml-cpu/ggml-cpu-quants.h |  120 +-
 2 files changed, 1945 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu-quants.c b/ggml/src/ggml-cpu/ggml-cpu-quants.c
index 40bded47..8e5af3e4 100644
--- a/ggml/src/ggml-cpu/ggml-cpu-quants.c
+++ b/ggml/src/ggml-cpu/ggml-cpu-quants.c
@@ -13,7 +13,8 @@
 #include <float.h>
 #include <stdlib.h> // for qsort
 #include <stdio.h>  // for GGML_ASSERT
-
+#include <time.h>
+#include <stdatomic.h>
 #define GROUP_MAX_EPS 1e-15f
 #define GROUP_MAX_EPS_IQ3_XXS 1e-8f
 #define GROUP_MAX_EPS_IQ2_S 1e-8f
@@ -4008,6 +4009,1830 @@ void ggml_vec_dot_q8_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const voi
     *s = sumf;
 }
 
+
+void
+matmul_q8_0_mmla_spack_destroy(matmul_q8_0_mmla_spack_t* spack)
+{
+    if (!spack) {
+        return;
+    }
+    if (spack->p) {
+        free(spack->p);
+        spack->p = NULL;
+    }
+    if (spack->scale) {
+        free(spack->scale);
+        spack->scale = NULL;
+    }
+    free(spack);
+}
+
+static void __attribute__((noinline))
+matmul_q8_0_mmla_spack_padded_A(size_t nr_real,
+                                size_t nr_pack,
+                                size_t K_Q8_0,
+                                const block_q8_0 * GGML_RESTRICT X,
+                                size_t stride_q_0,
+                                int8_t    * GGML_RESTRICT p,
+                                size_t p_stride,
+                                float32_t * GGML_RESTRICT scale,
+                                size_t scale_stride)
+{
+    const svbool_t pg_all = svptrue_b8();
+    const block_q8_0 zero_block = { 0 };
+    const bool has_padding = nr_real < nr_pack;
+
+    if (!has_padding) {
+        /*
+         * A fast path:
+         * 每 2 行 A pack 到：
+         *   [a0 low/high interleave]
+         *   [a1 low/high interleave]
+         */
+        for (size_t j = 0; j < nr_pack; j += 2) {
+            const block_q8_0 * GGML_RESTRICT x0 = &X[(j + 0) * stride_q_0];
+            const block_q8_0 * GGML_RESTRICT x1 = &X[(j + 1) * stride_q_0];
+
+            int8_t    * GGML_RESTRICT dst_p = &p[j * p_stride];
+            float32_t * GGML_RESTRICT dst_s =
+                &scale[j * scale_stride * 2];
+
+            for (size_t ki = 0; ki < K_Q8_0; ++ki) {
+                const block_q8_0 * GGML_RESTRICT va0 = &x0[ki];
+                const block_q8_0 * GGML_RESTRICT va1 = &x1[ki];
+
+                const size_t p_off = ki * QK8_0 * 2;
+
+                svuint64_t d0 = svld1_u64(pg_all, (const uint64_t *)&va0->qs[0]);
+                svuint64_t d1 = svld1_u64(pg_all, (const uint64_t *)&va1->qs[0]);
+
+                svuint64_t z0 = svzip1_u64(d0, d1);
+                svuint64_t z1 = svzip2_u64(d0, d1);
+
+                svst1_u64(pg_all, (uint64_t *)&dst_p[p_off + 0 * 32], z0);
+                svst1_u64(pg_all, (uint64_t *)&dst_p[p_off + 1 * 32], z1);
+
+                const float32_t s0 = GGML_FP16_TO_FP32(va0->d);
+                const float32_t s1 = GGML_FP16_TO_FP32(va1->d);
+
+                vst1q_f32(&dst_s[4 * ki], (float32x4_t){ s0, s0, s1, s1 });
+            }
+        }
+    } else {
+        /*
+         * A slow path:
+         * 有 padding，需要边界判断。由于前面已经 memset 过，
+         * padding 行即使跳过也保持 0。
+         */
+        for (size_t j = 0; j < nr_pack; j += 2) {
+            const bool valid0 = (j + 0) < nr_real;
+            const bool valid1 = (j + 1) < nr_real;
+
+            const block_q8_0 * GGML_RESTRICT x0 =
+                valid0 ? &X[(j + 0) * stride_q_0] : &zero_block;
+            const block_q8_0 * GGML_RESTRICT x1 =
+                valid1 ? &X[(j + 1) * stride_q_0] : &zero_block;
+
+            int8_t    * GGML_RESTRICT dst_p = &p[j * p_stride];
+            float32_t * GGML_RESTRICT dst_s =
+                &scale[j * scale_stride * 2];
+
+            for (size_t ki = 0; ki < K_Q8_0; ++ki) {
+                const block_q8_0 * GGML_RESTRICT va0 = valid0 ? &x0[ki] : &zero_block;
+                const block_q8_0 * GGML_RESTRICT va1 = valid1 ? &x1[ki] : &zero_block;
+
+                const size_t p_off = ki * QK8_0 * 2;
+
+                svuint64_t d0 = svld1_u64(pg_all, (const uint64_t *)&va0->qs[0]);
+                svuint64_t d1 = svld1_u64(pg_all, (const uint64_t *)&va1->qs[0]);
+
+                svuint64_t z0 = svzip1_u64(d0, d1);
+                svuint64_t z1 = svzip2_u64(d0, d1);
+
+                svst1_u64(pg_all, (uint64_t *)&dst_p[p_off + 0 * 32], z0);
+                svst1_u64(pg_all, (uint64_t *)&dst_p[p_off + 1 * 32], z1);
+
+                const float32_t s0 = valid0 ? GGML_FP16_TO_FP32(va0->d) : 0.0f;
+                const float32_t s1 = valid1 ? GGML_FP16_TO_FP32(va1->d) : 0.0f;
+
+                vst1q_f32(&dst_s[4 * ki], (float32x4_t){ s0, s0, s1, s1 });
+            }
+        }
+    }
+}
+
+static void __attribute__((noinline))
+matmul_q8_0_mmla_spack_padded_B(size_t nr_real,
+                                size_t nr_pack,
+                                size_t K_Q8_0,
+                                const block_q8_0 * GGML_RESTRICT X,
+                                size_t stride_q_0,
+                                int8_t    * GGML_RESTRICT p,
+                                size_t p_stride,
+                                float32_t * GGML_RESTRICT scale,
+                                size_t scale_stride)
+{
+    const block_q8_0 zero_block = { 0 };
+    const bool has_padding = nr_real < nr_pack;
+
+    if (!has_padding) {
+        /*
+         * B fast path:
+         * 每 4 行 B pack。
+         * QK8_0 == 32 时，直接 4 个 uint64_t group 展开。
+         */
+        GGML_ASSERT(QK8_0 == 32);
+
+        for (size_t i = 0; i < nr_pack; i += 4) {
+            const block_q8_0 * GGML_RESTRICT x0 = &X[(i + 0) * stride_q_0];
+            const block_q8_0 * GGML_RESTRICT x1 = &X[(i + 1) * stride_q_0];
+            const block_q8_0 * GGML_RESTRICT x2 = &X[(i + 2) * stride_q_0];
+            const block_q8_0 * GGML_RESTRICT x3 = &X[(i + 3) * stride_q_0];
+
+            int8_t    * GGML_RESTRICT dst_p = &p[i * p_stride];
+            float32_t * GGML_RESTRICT dst_s =
+                &scale[i * scale_stride * 2];
+
+            for (size_t ki = 0; ki < K_Q8_0; ++ki) {
+                const block_q8_0 * GGML_RESTRICT vb0 = &x0[ki];
+                const block_q8_0 * GGML_RESTRICT vb1 = &x1[ki];
+                const block_q8_0 * GGML_RESTRICT vb2 = &x2[ki];
+                const block_q8_0 * GGML_RESTRICT vb3 = &x3[ki];
+
+                uint64_t * GGML_RESTRICT dst =
+                    (uint64_t *)&dst_p[ki * QK8_0 * 4];
+
+                const uint64_t * GGML_RESTRICT s0 = (const uint64_t *)vb0->qs;
+                const uint64_t * GGML_RESTRICT s1 = (const uint64_t *)vb1->qs;
+                const uint64_t * GGML_RESTRICT s2 = (const uint64_t *)vb2->qs;
+                const uint64_t * GGML_RESTRICT s3 = (const uint64_t *)vb3->qs;
+
+                dst[0]  = s0[0];
+                dst[1]  = s1[0];
+                dst[2]  = s2[0];
+                dst[3]  = s3[0];
+
+                dst[4]  = s0[1];
+                dst[5]  = s1[1];
+                dst[6]  = s2[1];
+                dst[7]  = s3[1];
+
+                dst[8]  = s0[2];
+                dst[9]  = s1[2];
+                dst[10] = s2[2];
+                dst[11] = s3[2];
+
+                dst[12] = s0[3];
+                dst[13] = s1[3];
+                dst[14] = s2[3];
+                dst[15] = s3[3];
+
+                const float32_t b0 = GGML_FP16_TO_FP32(vb0->d);
+                const float32_t b1 = GGML_FP16_TO_FP32(vb1->d);
+                const float32_t b2 = GGML_FP16_TO_FP32(vb2->d);
+                const float32_t b3 = GGML_FP16_TO_FP32(vb3->d);
+
+                vst1q_f32(&dst_s[8 * ki + 0], (float32x4_t){ b0, b1, b0, b1 });
+                vst1q_f32(&dst_s[8 * ki + 4], (float32x4_t){ b2, b3, b2, b3 });
+            }
+        }
+    } else {
+        /*
+         * B slow path:
+         * 有 padding，保留边界判断。
+         */
+        GGML_ASSERT(QK8_0 == 32);
+
+        for (size_t i = 0; i < nr_pack; i += 4) {
+            const bool valid0 = (i + 0) < nr_real;
+            const bool valid1 = (i + 1) < nr_real;
+            const bool valid2 = (i + 2) < nr_real;
+            const bool valid3 = (i + 3) < nr_real;
+
+            const block_q8_0 * GGML_RESTRICT x0 =
+                valid0 ? &X[(i + 0) * stride_q_0] : &zero_block;
+            const block_q8_0 * GGML_RESTRICT x1 =
+                valid1 ? &X[(i + 1) * stride_q_0] : &zero_block;
+            const block_q8_0 * GGML_RESTRICT x2 =
+                valid2 ? &X[(i + 2) * stride_q_0] : &zero_block;
+            const block_q8_0 * GGML_RESTRICT x3 =
+                valid3 ? &X[(i + 3) * stride_q_0] : &zero_block;
+
+            int8_t    * GGML_RESTRICT dst_p = &p[i * p_stride];
+            float32_t * GGML_RESTRICT dst_s =
+                &scale[i * scale_stride * 2];
+
+            for (size_t ki = 0; ki < K_Q8_0; ++ki) {
+                const block_q8_0 * GGML_RESTRICT vb0 = valid0 ? &x0[ki] : &zero_block;
+                const block_q8_0 * GGML_RESTRICT vb1 = valid1 ? &x1[ki] : &zero_block;
+                const block_q8_0 * GGML_RESTRICT vb2 = valid2 ? &x2[ki] : &zero_block;
+                const block_q8_0 * GGML_RESTRICT vb3 = valid3 ? &x3[ki] : &zero_block;
+
+                uint64_t * GGML_RESTRICT dst =
+                    (uint64_t *)&dst_p[ki * QK8_0 * 4];
+
+                const uint64_t * GGML_RESTRICT s0 = (const uint64_t *)vb0->qs;
+                const uint64_t * GGML_RESTRICT s1 = (const uint64_t *)vb1->qs;
+                const uint64_t * GGML_RESTRICT s2 = (const uint64_t *)vb2->qs;
+                const uint64_t * GGML_RESTRICT s3 = (const uint64_t *)vb3->qs;
+
+                dst[0]  = s0[0];
+                dst[1]  = s1[0];
+                dst[2]  = s2[0];
+                dst[3]  = s3[0];
+
+                dst[4]  = s0[1];
+                dst[5]  = s1[1];
+                dst[6]  = s2[1];
+                dst[7]  = s3[1];
+
+                dst[8]  = s0[2];
+                dst[9]  = s1[2];
+                dst[10] = s2[2];
+                dst[11] = s3[2];
+
+                dst[12] = s0[3];
+                dst[13] = s1[3];
+                dst[14] = s2[3];
+                dst[15] = s3[3];
+
+                const float32_t b0 = valid0 ? GGML_FP16_TO_FP32(vb0->d) : 0.0f;
+                const float32_t b1 = valid1 ? GGML_FP16_TO_FP32(vb1->d) : 0.0f;
+                const float32_t b2 = valid2 ? GGML_FP16_TO_FP32(vb2->d) : 0.0f;
+                const float32_t b3 = valid3 ? GGML_FP16_TO_FP32(vb3->d) : 0.0f;
+
+                vst1q_f32(&dst_s[8 * ki + 0], (float32x4_t){ b0, b1, b0, b1 });
+                vst1q_f32(&dst_s[8 * ki + 4], (float32x4_t){ b2, b3, b2, b3 });
+            }
+        }
+    }
+}
+
+void
+matmul_q8_0_mmla_spack_padded(bool isA,
+                              size_t nr_real,
+                              size_t nr_pack,
+                              int dim,
+                              const block_q8_0* GGML_RESTRICT X,
+                              size_t column_bytes,
+                              matmul_q8_0_mmla_spack_t** out)
+{
+    const size_t K_Q8_0 = (dim + QK8_0 - 1) / QK8_0;
+
+    GGML_ASSERT(dim % 8 == 0);
+    GGML_ASSERT(X != NULL);
+    GGML_ASSERT(out != NULL);
+
+    if (isA) {
+        GGML_ASSERT((nr_pack % 2) == 0);
+    } else {
+        GGML_ASSERT((nr_pack % 4) == 0);
+    }
+    GGML_ASSERT(nr_pack >= nr_real);
+
+    const size_t stride_q_0 = column_bytes / sizeof(block_q8_0);
+    const size_t stride = isA ? 4 : 8;
+
+    const size_t sz_p     = sizeof(int8_t)    * nr_pack * K_Q8_0 * QK8_0;
+    const size_t sz_scale = sizeof(float32_t) * nr_pack * K_Q8_0 * stride;
+
+    matmul_q8_0_mmla_spack_t * spack = NULL;
+
+    if (*out != NULL && (*out)->sz_p == sz_p && (*out)->sz_scale == sz_scale) {
+        spack = *out;
+    } else {
+        if (*out != NULL) {
+            matmul_q8_0_mmla_spack_destroy(*out);
+            *out = NULL;
+        }
+
+        spack = (matmul_q8_0_mmla_spack_t *) malloc(sizeof(*spack));
+        GGML_ASSERT(spack != NULL);
+
+        memset(spack, 0, sizeof(*spack));
+
+        void *tmp = NULL;
+
+        int rc = posix_memalign(&tmp, 64, sz_p);
+        GGML_ASSERT(rc == 0 && tmp != NULL);
+        spack->p = (int8_t *) tmp;
+
+        tmp = NULL;
+        rc = posix_memalign(&tmp, 64, sz_scale);
+        GGML_ASSERT(rc == 0 && tmp != NULL);
+        spack->scale = (float32_t *) tmp;
+
+        spack->p_stride     = K_Q8_0 * QK8_0;
+        spack->scale_stride = K_Q8_0;
+        spack->sz_p         = sz_p;
+        spack->sz_scale     = sz_scale;
+    }
+
+    const bool has_padding = nr_real < nr_pack;
+
+    if (has_padding) {
+        memset(spack->p,     0, sz_p);
+        memset(spack->scale, 0, sz_scale);
+    }
+
+    if (isA) {
+        matmul_q8_0_mmla_spack_padded_A(
+            nr_real, nr_pack, K_Q8_0,
+            X, stride_q_0,
+            spack->p, spack->p_stride,
+            spack->scale, spack->scale_stride);
+    } else {
+        matmul_q8_0_mmla_spack_padded_B(
+            nr_real, nr_pack, K_Q8_0,
+            X, stride_q_0,
+            spack->p, spack->p_stride,
+            spack->scale, spack->scale_stride);
+    }
+
+    *out = spack;
+}
+
+static inline void
+matmul_accumulate_back_f32_tile(float * GGML_RESTRICT dst,
+                                size_t dst_col_stride,
+                                const float * GGML_RESTRICT src,
+                                size_t src_col_stride,
+                                size_t M_real,
+                                size_t N_real)
+{
+    for (size_t n = 0; n < N_real; ++n) {
+        for (size_t m = 0; m < M_real; ++m) {
+            dst[n * dst_col_stride + m] += src[n * src_col_stride + m];
+        }
+    }
+}
+
+
+void
+matmul_q8_0_mmla_spack_b(size_t na,
+                         size_t nb,
+                         int dim,
+                         const void* GGML_RESTRICT a,
+                         const void* GGML_RESTRICT b,
+                         void* GGML_RESTRICT c,
+                         size_t c_column_bytes,
+                         matmul_q8_0_mmla_spack_func main_func)
+{
+    assert(svcntb() == QK8_0);
+    assert(dim % 8 == 0);
+
+    const size_t M = na;
+    const size_t N = nb;
+    const size_t K = dim;
+
+    const block_q8_0* GGML_RESTRICT A = (const block_q8_0*)(a);
+    const block_q8_0* GGML_RESTRICT B = (const block_q8_0*)(b);
+    float32_t* GGML_RESTRICT C = (float32_t*)(c);
+
+    const size_t c_stride = c_column_bytes / sizeof(float32_t);
+
+    // 清零 C，后续 K 分块累加
+
+    for (size_t i = 0; i < N; ++i) {
+        for (size_t j = 0; j < M; ++j) {
+            C[i * c_stride + j] = 0.0f;
+        }
+    }
+    const size_t M_BLK = 256; // 当前为 16
+    const size_t N_BLK = 64; // 当前为 32
+    const size_t K_BLK = 2048;
+
+    const size_t a_column_bytes = ggml_row_size(GGML_TYPE_Q8_0, K);
+    const size_t b_column_bytes = ggml_row_size(GGML_TYPE_Q8_0, K);
+
+    const size_t a_stride_q_0 = a_column_bytes / sizeof(block_q8_0);
+    const size_t b_stride_q_0 = b_column_bytes / sizeof(block_q8_0);
+
+    matmul_q8_0_mmla_spack_t* pack_a = NULL;
+    matmul_q8_0_mmla_spack_t* pack_b = NULL;
+    matmul_q8_0_mmla_spack_t* pack_a_tile = NULL;
+    matmul_q8_0_mmla_spack_t* pack_b_tile = NULL;
+
+    float *tmp_c = NULL;
+    size_t tmp_c_cap = 0;
+
+    /*
+     * 新主循环：
+     *
+     * 原来是：
+     *   for n
+     *     for m
+     *       for ki
+     *         pack A
+     *         pack B
+     *
+     * 现在是：
+     *   for m
+     *     for ki
+     *       pack A once
+     *       for n
+     *         pack B
+     *
+     * 这样 -b512 下，同一个 A panel 不再被 16 个 N tile 重复 pack。
+     */
+    for (size_t m = 0; m < M; m += M_BLK) {
+        const size_t na_cur = MIN(M_BLK, M - m);
+
+        /*
+         * 如果 M 方向不是 8 的倍数，直接对这个 m tile 的所有 n tile 走原来的 leftover 完整 K 路径。
+         * 这样可以避免在 K 分块循环里混入 full-K leftover，保证正确性。
+         */
+        if ((na_cur % 8) != 0) {
+            for (size_t n = 0; n < N; n += N_BLK) {
+                const size_t nb_cur = MIN(N_BLK, N - n);
+
+                const size_t na_pad = (na_cur + 3) & ~(size_t)3;
+                const size_t nb_pad = (nb_cur + 3) & ~(size_t)3;
+
+                const size_t tmp_need = na_pad * nb_pad;
+                if (tmp_need > tmp_c_cap) {
+                    free(tmp_c);
+                    tmp_c = NULL;
+                    tmp_c_cap = 0;
+
+                    void *ptr = NULL;
+                    int rc = posix_memalign(&ptr, 64, tmp_need * sizeof(float));
+                    GGML_ASSERT(rc == 0 && ptr != NULL);
+                    tmp_c = (float *)ptr;
+                    tmp_c_cap = tmp_need;
+                }
+
+                for (size_t jj = 0; jj < nb_pad; ++jj) {
+                    for (size_t ii = 0; ii < na_pad; ++ii) {
+                        tmp_c[jj * na_pad + ii] = 0.0f;
+                    }
+                }
+
+                matmul_q8_0_mmla_4x4_tiled_padded(
+                    na_cur,
+                    nb_cur,
+                    na_pad,
+                    nb_pad,
+                    K,
+                    m,
+                    n,
+                    0,
+                    A,
+                    B,
+                    a_stride_q_0,
+                    b_stride_q_0,
+                    a_column_bytes,
+                    b_column_bytes,
+                    tmp_c,
+                    &pack_a_tile,
+                    &pack_b_tile);
+
+                matmul_accumulate_back_f32_tile(
+                    &C[n * c_stride + m],
+                    c_stride,
+                    tmp_c,
+                    na_pad,
+                    na_cur,
+                    nb_cur);
+            }
+
+            continue;
+        }
+
+        for (size_t ki = 0; ki < K; ki += K_BLK) {
+            const size_t k  = MIN(K_BLK, K - ki);
+            const size_t kb = ki / QK8_0;
+
+            /*
+             * A panel 只 pack 一次，然后复用给所有 n tile。
+             */
+            matmul_q8_0_mmla_spack_padded(
+                true,
+                na_cur,
+                na_cur,
+                (int) k,
+                &A[m * a_stride_q_0 + kb],
+                a_column_bytes,
+                &pack_a);
+
+            for (size_t n = 0; n < N; n += N_BLK) {
+                const size_t nb_cur = MIN(N_BLK, N - n);
+
+                if ((nb_cur % 8) == 0) {
+                    matmul_q8_0_mmla_spack_padded(
+                        false,
+                        nb_cur,
+                        nb_cur,
+                        (int) k,
+                        &B[n * b_stride_q_0 + kb],
+                        b_column_bytes,
+                        &pack_b);
+                    main_func(
+                        na_cur,
+                        nb_cur,
+                        k,
+                        pack_a,
+                        pack_b,
+                        &C[n * c_stride + m],
+                        c_column_bytes);
+                } else {
+                    /*
+                     * N 方向 leftover：为了保持和原逻辑一致，用完整 K 的 4x4 tiled padded 路径。
+                     * 注意：因为当前已经在 ki 循环里，所以只允许 ki == 0 时做一次，
+                     * 其他 ki 跳过，避免重复累加。
+                     */
+                    if (ki == 0) {
+                        const size_t na_pad = (na_cur + 3) & ~(size_t)3;
+                        const size_t nb_pad = (nb_cur + 3) & ~(size_t)3;
+
+                        const size_t tmp_need = na_pad * nb_pad;
+                        if (tmp_need > tmp_c_cap) {
+                            free(tmp_c);
+                            tmp_c = NULL;
+                            tmp_c_cap = 0;
+
+                            void *ptr = NULL;
+                            int rc = posix_memalign(&ptr, 64, tmp_need * sizeof(float));
+                            GGML_ASSERT(rc == 0 && ptr != NULL);
+                            tmp_c = (float *)ptr;
+                            tmp_c_cap = tmp_need;
+                        }
+
+                        for (size_t jj = 0; jj < nb_pad; ++jj) {
+                            for (size_t ii = 0; ii < na_pad; ++ii) {
+                                tmp_c[jj * na_pad + ii] = 0.0f;
+                            }
+                        }
+
+                        matmul_q8_0_mmla_4x4_tiled_padded(
+                            na_cur,
+                            nb_cur,
+                            na_pad,
+                            nb_pad,
+                            K,
+                            m,
+                            n,
+                            0,
+                            A,
+                            B,
+                            a_stride_q_0,
+                            b_stride_q_0,
+                            a_column_bytes,
+                            b_column_bytes,
+                            tmp_c,
+                            &pack_a_tile,
+                            &pack_b_tile);
+
+                        matmul_accumulate_back_f32_tile(
+                            &C[n * c_stride + m],
+                            c_stride,
+                            tmp_c,
+                            na_pad,
+                            na_cur,
+                            nb_cur);
+                    }
+                }
+            }
+        }
+    }
+
+    free(tmp_c);
+    matmul_q8_0_mmla_spack_destroy(pack_a);
+    matmul_q8_0_mmla_spack_destroy(pack_b);
+    matmul_q8_0_mmla_spack_destroy(pack_a_tile);
+    matmul_q8_0_mmla_spack_destroy(pack_b_tile);
+}
+
+void
+matmul_q8_0_mmla_8x8_b_micro_spack_neon(
+        size_t M,
+        size_t N,
+        size_t K,
+        const matmul_q8_0_mmla_spack_t * GGML_RESTRICT pack_a,
+        const matmul_q8_0_mmla_spack_t * GGML_RESTRICT pack_b,
+        void * GGML_RESTRICT c,
+        size_t c_column_bytes)
+{
+    GGML_ASSERT(M % 8 == 0);
+    GGML_ASSERT(N % 8 == 0);
+    GGML_ASSERT(QK8_0 == 32);
+    GGML_ASSERT(c_column_bytes % sizeof(float32_t) == 0);
+
+    const size_t K_Q8_0 = (K + QK8_0 - 1) / QK8_0;
+
+    float32_t * GGML_RESTRICT C = (float32_t *) c;
+    const size_t c_stride = c_column_bytes / sizeof(float32_t);
+
+#define LOAD_ACC_2R_2C(row_base, col_base)                              \
+    ((float32x4_t) {                                                    \
+        C[((col_base) + 0) * c_stride + ((row_base) + 0)],              \
+        C[((col_base) + 1) * c_stride + ((row_base) + 0)],              \
+        C[((col_base) + 0) * c_stride + ((row_base) + 1)],              \
+        C[((col_base) + 1) * c_stride + ((row_base) + 1)]               \
+    })
+
+#define STORE_ACC_2R_2C(acc, row_base, col_base) do {                    \
+        C[((col_base) + 0) * c_stride + ((row_base) + 0)] =             \
+            vgetq_lane_f32((acc), 0);                                   \
+        C[((col_base) + 1) * c_stride + ((row_base) + 0)] =             \
+            vgetq_lane_f32((acc), 1);                                   \
+        C[((col_base) + 0) * c_stride + ((row_base) + 1)] =             \
+            vgetq_lane_f32((acc), 2);                                   \
+        C[((col_base) + 1) * c_stride + ((row_base) + 1)] =             \
+            vgetq_lane_f32((acc), 3);                                   \
+    } while (0)
+
+    /*
+     * 当前处理两个 A row-pair，共 4 行；
+     * 同时处理两个 B 四列 pack，共 8 列。
+     *
+     * acc0x: A 的第一个 row-pair
+     * acc1x: A 的第二个 row-pair
+     *
+     * x=0: B 列 i+0/i+1
+     * x=1: B 列 i+2/i+3
+     * x=2: B 列 i+4/i+5
+     * x=3: B 列 i+6/i+7
+     */
+#define MMLA_K8_STEP(a_off, b01_off, b23_off) do {                       \
+        const int8x16_t av0 = vld1q_s8(pa0 + (a_off));                  \
+        const int8x16_t av1 = vld1q_s8(pa1 + (a_off));                  \
+                                                                            \
+        const int8x16_t bv00 = vld1q_s8(pb0 + (b01_off));               \
+        const int8x16_t bv01 = vld1q_s8(pb0 + (b23_off));               \
+        const int8x16_t bv10 = vld1q_s8(pb1 + (b01_off));               \
+        const int8x16_t bv11 = vld1q_s8(pb1 + (b23_off));               \
+                                                                            \
+        acc00s = vmmlaq_s32(acc00s, av0, bv00);                         \
+        acc01s = vmmlaq_s32(acc01s, av0, bv01);                         \
+        acc02s = vmmlaq_s32(acc02s, av0, bv10);                         \
+        acc03s = vmmlaq_s32(acc03s, av0, bv11);                         \
+                                                                            \
+        acc10s = vmmlaq_s32(acc10s, av1, bv00);                         \
+        acc11s = vmmlaq_s32(acc11s, av1, bv01);                         \
+        acc12s = vmmlaq_s32(acc12s, av1, bv10);                         \
+        acc13s = vmmlaq_s32(acc13s, av1, bv11);                         \
+    } while (0)
+
+#define COMPUTE_4X8(                                                     \
+        row_base,                                                       \
+        psa_pair0, psa_pair1,                                           \
+        pap_pair0, pap_pair1) do {                                      \
+                                                                            \
+        float32x4_t acc00f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 0, i + 0);                     \
+        float32x4_t acc01f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 0, i + 2);                     \
+        float32x4_t acc02f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 0, i + 4);                     \
+        float32x4_t acc03f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 0, i + 6);                     \
+                                                                            \
+        float32x4_t acc10f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 2, i + 0);                     \
+        float32x4_t acc11f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 2, i + 2);                     \
+        float32x4_t acc12f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 2, i + 4);                     \
+        float32x4_t acc13f =                                            \
+            LOAD_ACC_2R_2C((row_base) + 2, i + 6);                     \
+                                                                            \
+        const float32_t * GGML_RESTRICT sa0p = (psa_pair0);             \
+        const float32_t * GGML_RESTRICT sa1p = (psa_pair1);             \
+        const float32_t * GGML_RESTRICT sb0p = psb0;                    \
+        const float32_t * GGML_RESTRICT sb1p = psb1;                    \
+                                                                            \
+        const int8_t * GGML_RESTRICT pa0 = (pap_pair0);                 \
+        const int8_t * GGML_RESTRICT pa1 = (pap_pair1);                 \
+        const int8_t * GGML_RESTRICT pb0 = pbp0;                        \
+        const int8_t * GGML_RESTRICT pb1 = pbp1;                        \
+                                                                            \
+        for (size_t ki = 0; ki < K_Q8_0; ++ki) {                        \
+            /* A 的两个 row-pair scale。 */                              \
+            const float32x4_t scale_a0 = vld1q_f32(sa0p);               \
+            const float32x4_t scale_a1 = vld1q_f32(sa1p);               \
+            sa0p += 4;                                                   \
+            sa1p += 4;                                                   \
+                                                                            \
+            /*                                                          \
+             * 每个 B 四列 pack 有两个列对的 scale：                     \
+             *   +0：列 0/1                                             \
+             *   +4：列 2/3                                             \
+             */                                                         \
+            const float32x4_t scale_b00 = vld1q_f32(sb0p + 0);          \
+            const float32x4_t scale_b01 = vld1q_f32(sb0p + 4);          \
+            const float32x4_t scale_b10 = vld1q_f32(sb1p + 0);          \
+            const float32x4_t scale_b11 = vld1q_f32(sb1p + 4);          \
+            sb0p += 8;                                                   \
+            sb1p += 8;                                                   \
+                                                                            \
+            int32x4_t acc00s = vdupq_n_s32(0);                           \
+            int32x4_t acc01s = vdupq_n_s32(0);                           \
+            int32x4_t acc02s = vdupq_n_s32(0);                           \
+            int32x4_t acc03s = vdupq_n_s32(0);                           \
+            int32x4_t acc10s = vdupq_n_s32(0);                           \
+            int32x4_t acc11s = vdupq_n_s32(0);                           \
+            int32x4_t acc12s = vdupq_n_s32(0);                           \
+            int32x4_t acc13s = vdupq_n_s32(0);                           \
+                                                                            \
+            /*                                                          \
+             * A/B packed 对应关系：                                    \
+             *                                                          \
+             * A +0  : K  0..7                                          \
+             * B +0  : cols 0/1, K  0..7                               \
+             * B +16 : cols 2/3, K  0..7                               \
+             *                                                          \
+             * A +16 : K  8..15                                         \
+             * B +32 : cols 0/1, K  8..15                              \
+             * B +48 : cols 2/3, K  8..15                              \
+             *                                                          \
+             * A +32 : K 16..23                                         \
+             * B +64 : cols 0/1, K 16..23                              \
+             * B +80 : cols 2/3, K 16..23                              \
+             *                                                          \
+             * A +48  : K 24..31                                        \
+             * B +96  : cols 0/1, K 24..31                             \
+             * B +112 : cols 2/3, K 24..31                             \
+             */                                                         \
+            MMLA_K8_STEP( 0,  0,  16);                                  \
+            MMLA_K8_STEP(16, 32,  48);                                  \
+            MMLA_K8_STEP(32, 64,  80);                                  \
+            MMLA_K8_STEP(48, 96, 112);                                  \
+                                                                            \
+            pa0 += 64;                                                   \
+            pa1 += 64;                                                   \
+            pb0 += 128;                                                  \
+            pb1 += 128;                                                  \
+                                                                            \
+            /*                                                          \
+             * 逐项做 convert、scale 和 FP32 累加，避免同时保留          \
+             * 8 个 scale product 临时向量。                             \
+             */                                                         \
+            acc00f = vfmaq_f32(                                         \
+                acc00f,                                                 \
+                vcvtq_f32_s32(acc00s),                                  \
+                vmulq_f32(scale_a0, scale_b00));                        \
+                                                                            \
+            acc01f = vfmaq_f32(                                         \
+                acc01f,                                                 \
+                vcvtq_f32_s32(acc01s),                                  \
+                vmulq_f32(scale_a0, scale_b01));                        \
+                                                                            \
+            acc02f = vfmaq_f32(                                         \
+                acc02f,                                                 \
+                vcvtq_f32_s32(acc02s),                                  \
+                vmulq_f32(scale_a0, scale_b10));                        \
+                                                                            \
+            acc03f = vfmaq_f32(                                         \
+                acc03f,                                                 \
+                vcvtq_f32_s32(acc03s),                                  \
+                vmulq_f32(scale_a0, scale_b11));                        \
+                                                                            \
+            acc10f = vfmaq_f32(                                         \
+                acc10f,                                                 \
+                vcvtq_f32_s32(acc10s),                                  \
+                vmulq_f32(scale_a1, scale_b00));                        \
+                                                                            \
+            acc11f = vfmaq_f32(                                         \
+                acc11f,                                                 \
+                vcvtq_f32_s32(acc11s),                                  \
+                vmulq_f32(scale_a1, scale_b01));                        \
+                                                                            \
+            acc12f = vfmaq_f32(                                         \
+                acc12f,                                                 \
+                vcvtq_f32_s32(acc12s),                                  \
+                vmulq_f32(scale_a1, scale_b10));                        \
+                                                                            \
+            acc13f = vfmaq_f32(                                         \
+                acc13f,                                                 \
+                vcvtq_f32_s32(acc13s),                                  \
+                vmulq_f32(scale_a1, scale_b11));                        \
+        }                                                               \
+                                                                            \
+        STORE_ACC_2R_2C(acc00f, (row_base) + 0, i + 0);                 \
+        STORE_ACC_2R_2C(acc01f, (row_base) + 0, i + 2);                 \
+        STORE_ACC_2R_2C(acc02f, (row_base) + 0, i + 4);                 \
+        STORE_ACC_2R_2C(acc03f, (row_base) + 0, i + 6);                 \
+                                                                            \
+        STORE_ACC_2R_2C(acc10f, (row_base) + 2, i + 0);                 \
+        STORE_ACC_2R_2C(acc11f, (row_base) + 2, i + 2);                 \
+        STORE_ACC_2R_2C(acc12f, (row_base) + 2, i + 4);                 \
+        STORE_ACC_2R_2C(acc13f, (row_base) + 2, i + 6);                 \
+    } while (0)
+
+    for (size_t i = 0; i < N; i += 8) {
+        /*
+         * B 前四列与后四列的 pack 起点。
+         */
+        const float32_t * GGML_RESTRICT psb0 =
+            &pack_b->scale[
+                (i + 0) * pack_b->scale_stride * 2];
+
+        const float32_t * GGML_RESTRICT psb1 =
+            &pack_b->scale[
+                (i + 4) * pack_b->scale_stride * 2];
+
+        const int8_t * GGML_RESTRICT pbp0 =
+            &pack_b->p[(i + 0) * pack_b->p_stride];
+
+        const int8_t * GGML_RESTRICT pbp1 =
+            &pack_b->p[(i + 4) * pack_b->p_stride];
+
+        for (size_t j = 0; j < M; j += 8) {
+            /*
+             * 前四行。
+             */
+            const float32_t * GGML_RESTRICT psa0 =
+                &pack_a->scale[
+                    (j + 0) * pack_a->scale_stride * 2];
+
+            const float32_t * GGML_RESTRICT psa1 =
+                &pack_a->scale[
+                    (j + 2) * pack_a->scale_stride * 2];
+
+            const int8_t * GGML_RESTRICT pap0 =
+                &pack_a->p[(j + 0) * pack_a->p_stride];
+
+            const int8_t * GGML_RESTRICT pap1 =
+                &pack_a->p[(j + 2) * pack_a->p_stride];
+
+            COMPUTE_4X8(
+                j + 0,
+                psa0,
+                psa1,
+                pap0,
+                pap1);
+
+            /*
+             * 后四行。
+             */
+            const float32_t * GGML_RESTRICT psa2 =
+                &pack_a->scale[
+                    (j + 4) * pack_a->scale_stride * 2];
+
+            const float32_t * GGML_RESTRICT psa3 =
+                &pack_a->scale[
+                    (j + 6) * pack_a->scale_stride * 2];
+
+            const int8_t * GGML_RESTRICT pap2 =
+                &pack_a->p[(j + 4) * pack_a->p_stride];
+
+            const int8_t * GGML_RESTRICT pap3 =
+                &pack_a->p[(j + 6) * pack_a->p_stride];
+
+            COMPUTE_4X8(
+                j + 4,
+                psa2,
+                psa3,
+                pap2,
+                pap3);
+        }
+    }
+
+#undef COMPUTE_4X8
+#undef MMLA_K8_STEP
+#undef LOAD_ACC_2R_2C
+#undef STORE_ACC_2R_2C
+}
+
+void
+matmul_q8_0_mmla_8x8_b_micro_spack(size_t M,
+                                   size_t N,
+                                   size_t K,
+                                   const matmul_q8_0_mmla_spack_t* pack_a,
+                                   const matmul_q8_0_mmla_spack_t* pack_b,
+                                   void* GGML_RESTRICT c,
+                                   size_t c_column_bytes)
+{
+    // fprintf(stderr, "M=%d,N=%d,K=%d\n", M,N,K);
+    assert(M % 8 == 0 && N % 8 == 0);
+    const size_t K_Q8_0 = (K + QK8_0 - 1) / QK8_0;
+    register svfloat32_t acc00f asm("z0");
+    register svfloat32_t acc01f asm("z1");
+    register svfloat32_t acc10f asm("z2");
+    register svfloat32_t acc11f asm("z3");
+    register svfloat32_t acc20f asm("z4");
+    register svfloat32_t acc21f asm("z5");
+    register svfloat32_t acc30f asm("z6");
+    register svfloat32_t acc31f asm("z7");
+    svbool_t pg_all = svptrue_b8();
+    svbool_t pg_b32_vl2 = svptrue_pat_b32(SV_VL2);
+    float32_t* GGML_RESTRICT C = (float32_t*)(c);
+    size_t c_stride = c_column_bytes / sizeof(float32_t);
+    const size_t indices_factor = sizeof(uint64_t) / sizeof(int8_t);
+    svuint64_t indices_storage_b64 = svindex_u64(0, c_stride / 2);
+    const static uint32_t acc_table_v[8] = { 0, 2, 1, 3, 4, 6, 5, 7 };
+    const static uint64_t zero_x[8] = { 0 };
+
+    for (size_t i = 0; i < N; i += 8) {
+        for (size_t j = 0; j < M; j += 8) {
+            svuint32_t acc_table = svld1_u32(pg_all, acc_table_v);
+#define LOAD_C(a, b)                                                                                                   \
+    do {                                                                                                               \
+        svfloat32_t acc_tmp = svreinterpret_f32_u64(svld1_gather_u64index_u64(                                         \
+          pg_all, (uint64_t*)&C[((i + (b * 4)) * c_stride) + (j + (a * 2))], indices_storage_b64));                    \
+        (acc##a##b##f) = svtbl_f32(acc_tmp, acc_table);                                                                \
+    } while (0)
+            LOAD_C(0, 0);
+            LOAD_C(0, 1);
+            LOAD_C(1, 0);
+            LOAD_C(1, 1);
+            LOAD_C(2, 0);
+            LOAD_C(2, 1);
+            LOAD_C(3, 0);
+            LOAD_C(3, 1);
+#undef LOAD_C
+            const float32_t* psa0 = &pack_a->scale[(j + 2 * 0) * pack_a->scale_stride * 2];
+            const float32_t* psa1 = &pack_a->scale[(j + 2 * 1) * pack_a->scale_stride * 2];
+            const float32_t* psa2 = &pack_a->scale[(j + 2 * 2) * pack_a->scale_stride * 2];
+            const float32_t* psa3 = &pack_a->scale[(j + 2 * 3) * pack_a->scale_stride * 2];
+            const float32_t* psb0 = &pack_b->scale[(i + 4 * 0) * pack_b->scale_stride * 2];
+            const float32_t* psb1 = &pack_b->scale[(i + 4 * 1) * pack_b->scale_stride * 2];
+            const int8_t* pap0 = &pack_a->p[(j + 0 * 2) * pack_a->p_stride];
+            const int8_t* pap1 = &pack_a->p[(j + 1 * 2) * pack_a->p_stride];
+            const int8_t* pap2 = &pack_a->p[(j + 2 * 2) * pack_a->p_stride];
+            const int8_t* pap3 = &pack_a->p[(j + 3 * 2) * pack_a->p_stride];
+            const int8_t* pbp0 = &pack_b->p[(i + 0 * 4) * pack_b->p_stride];
+            const int8_t* pbp1 = &pack_b->p[(i + 1 * 4) * pack_b->p_stride];
+            for (size_t ki = 0; ki < K_Q8_0; ki += 1) {
+                // 920B: minimal 94 instr in 60 cycle, ipc 1.566; process 4*32*8 elements, 4*32*8*2*2 MACs
+                // smmla最高算力 => 371GOP/s; 理论 => 198GOP/s; 实际 => 142GOP/s
+                register svint32_t acc00s asm("z8");
+                register svint32_t acc01s asm("z9");
+                register svint32_t acc10s asm("z10");
+                register svint32_t acc11s asm("z11");
+                register svint32_t acc20s asm("z12");
+                register svint32_t acc21s asm("z13");
+                register svint32_t acc30s asm("z14");
+                register svint32_t acc31s asm("z15");
+// #ifdef GEM5
+// #define LOAD_ZERO(acc) (acc) = svdup_s32(0)
+// #else
+#define LOAD_ZERO(acc)                                                                                                 \
+    asm volatile("ld1rb { %[zt].b }, %[pg]/z, [%[zero]]\n"                                                             \
+                 : [zt] "=w"((acc))                                                                                    \
+                 : [pg] "Upl"(pg_all), [zero] "r"(&zero_x[0])                                                          \
+                 : "memory")
+// #endif
+                LOAD_ZERO(acc00s);
+                LOAD_ZERO(acc01s);
+                LOAD_ZERO(acc10s);
+                LOAD_ZERO(acc11s);
+                LOAD_ZERO(acc20s);
+                LOAD_ZERO(acc21s);
+                LOAD_ZERO(acc30s);
+                LOAD_ZERO(acc31s);
+#undef LOAD_ZERO
+                const int8_t* pa0 = &pap0[ki * QK8_0 * 2];
+                const int8_t* pa1 = &pap1[ki * QK8_0 * 2];
+                const int8_t* pa2 = &pap2[ki * QK8_0 * 2];
+                const int8_t* pa3 = &pap3[ki * QK8_0 * 2];
+                const int8_t* pb0 = &pbp0[ki * QK8_0 * 4];
+                const int8_t* pb1 = &pbp1[ki * QK8_0 * 4];
+                for (size_t di2 = 0; di2 < QK8_0 * 2 && false; di2 += 16) {
+                    register svint8_t a0 asm("z16") = svld1rq_s8(pg_all, &pa0[di2]);
+                    register svint8_t a1 asm("z17") = svld1rq_s8(pg_all, &pa1[di2]);
+                    register svint8_t a2 asm("z18") = svld1rq_s8(pg_all, &pa2[di2]);
+                    register svint8_t a3 asm("z19") = svld1rq_s8(pg_all, &pa3[di2]);
+                    register svint8_t b0 asm("z20") = svld1_s8(pg_all, &pb0[2 * di2]);
+                    register svint8_t b1 asm("z21") = svld1_s8(pg_all, &pb1[2 * di2]);
+                    acc00s = svmmla_s32(acc00s, a0, b0);
+                    acc01s = svmmla_s32(acc01s, a0, b1);
+                    acc10s = svmmla_s32(acc10s, a1, b0);
+                    acc11s = svmmla_s32(acc11s, a1, b1);
+                    acc20s = svmmla_s32(acc20s, a2, b0);
+                    acc21s = svmmla_s32(acc21s, a2, b1);
+                    acc30s = svmmla_s32(acc30s, a3, b0);
+                    acc31s = svmmla_s32(acc31s, a3, b1);
+                }
+                if (true) {
+                    register svint8_t a0M1 asm("z16");
+                    register svint8_t a1M1 asm("z17");
+                    register svint8_t a2M1 asm("z18");
+                    register svint8_t a3M1 asm("z19");
+                    register svint8_t b0M1 asm("z20");
+                    register svint8_t b1M1 asm("z21");
+                    register svint8_t a0M2 asm("z22");
+                    register svint8_t a1M2 asm("z23");
+                    register svint8_t a2M2 asm("z24");
+                    register svint8_t a3M2 asm("z25");
+                    register svint8_t b0M2 asm("z26");
+                    register svint8_t b1M2 asm("z27");
+#define MICRO_I                                                                                                        \
+    do {                                                                                                               \
+        asm volatile("ld1rqb { %[a0M1].b }, %[pg]/z, [%[pa0], #(0 * 16)]\n"                                            \
+                     "ld1rqb { %[a1M1].b }, %[pg]/z, [%[pa1], #(0 * 16)]\n"                                            \
+                     "ld1rqb { %[a2M1].b }, %[pg]/z, [%[pa2], #(0 * 16)]\n"                                            \
+                     "ld1rqb { %[a3M1].b }, %[pg]/z, [%[pa3], #(0 * 16)]\n"                                            \
+                     "ld1b { %[b0M1].b }, %[pg]/z, [%[pb0], #0, mul vl]\n"                                             \
+                     "ld1b { %[b1M1].b }, %[pg]/z, [%[pb1], #0, mul vl]\n"                                             \
+                     : [a0M1] "=w"(a0M1),                                                                              \
+                       [a1M1] "=w"(a1M1),                                                                              \
+                       [a2M1] "=w"(a2M1),                                                                              \
+                       [a3M1] "=w"(a3M1),                                                                              \
+                       [b0M1] "=w"(b0M1),                                                                              \
+                       [b1M1] "=w"(b1M1)                                                                               \
+                     : [pg] "Upl"(pg_all),                                                                             \
+                       [pa0] "r"(pa0),                                                                                 \
+                       [pa1] "r"(pa1),                                                                                 \
+                       [pa2] "r"(pa2),                                                                                 \
+                       [pa3] "r"(pa3),                                                                                 \
+                       [pb0] "r"(pb0),                                                                                 \
+                       [pb1] "r"(pb1)                                                                                  \
+                     : "memory");                                                                                      \
+        asm volatile("ld1rqb { %[a0M2].b }, %[pg]/z, [%[pa0], #(1 * 16)]\n"                                            \
+                     "ld1rqb { %[a1M2].b }, %[pg]/z, [%[pa1], #(1 * 16)]\n"                                            \
+                     "ld1rqb { %[a2M2].b }, %[pg]/z, [%[pa2], #(1 * 16)]\n"                                            \
+                     "ld1rqb { %[a3M2].b }, %[pg]/z, [%[pa3], #(1 * 16)]\n"                                            \
+                     "ld1b { %[b0M2].b }, %[pg]/z, [%[pb0], #1, mul vl]\n"                                             \
+                     "ld1b { %[b1M2].b }, %[pg]/z, [%[pb1], #1, mul vl]\n"                                             \
+                     : [a0M2] "=w"(a0M2),                                                                              \
+                       [a1M2] "=w"(a1M2),                                                                              \
+                       [a2M2] "=w"(a2M2),                                                                              \
+                       [a3M2] "=w"(a3M2),                                                                              \
+                       [b0M2] "=w"(b0M2),                                                                              \
+                       [b1M2] "=w"(b1M2)                                                                               \
+                     : [pg] "Upl"(pg_all),                                                                             \
+                       [pa0] "r"(pa0),                                                                                 \
+                       [pa1] "r"(pa1),                                                                                 \
+                       [pa2] "r"(pa2),                                                                                 \
+                       [pa3] "r"(pa3),                                                                                 \
+                       [pb0] "r"(pb0),                                                                                 \
+                       [pb1] "r"(pb1)                                                                                  \
+                     : "memory");                                                                                      \
+        asm volatile("smmla %[acc00s].s, %[a0M1].b, %[b0M1].b\n"                                                       \
+                     "smmla %[acc01s].s, %[a0M1].b, %[b1M1].b\n"                                                       \
+                     "smmla %[acc10s].s, %[a1M1].b, %[b0M1].b\n"                                                       \
+                     "smmla %[acc11s].s, %[a1M1].b, %[b1M1].b\n"                                                       \
+                     "smmla %[acc20s].s, %[a2M1].b, %[b0M1].b\n"                                                       \
+                     "smmla %[acc21s].s, %[a2M1].b, %[b1M1].b\n"                                                       \
+                     "smmla %[acc30s].s, %[a3M1].b, %[b0M1].b\n"                                                       \
+                     "smmla %[acc31s].s, %[a3M1].b, %[b1M1].b\n"                                                       \
+                     : [acc00s] "+w"(acc00s),                                                                          \
+                       [acc01s] "+w"(acc01s),                                                                          \
+                       [acc10s] "+w"(acc10s),                                                                          \
+                       [acc11s] "+w"(acc11s),                                                                          \
+                       [acc20s] "+w"(acc20s),                                                                          \
+                       [acc21s] "+w"(acc21s),                                                                          \
+                       [acc30s] "+w"(acc30s),                                                                          \
+                       [acc31s] "+w"(acc31s)                                                                           \
+                     : [pg] "Upl"(pg_all),                                                                             \
+                       [a0M1] "w"(a0M1),                                                                               \
+                       [a1M1] "w"(a1M1),                                                                               \
+                       [a2M1] "w"(a2M1),                                                                               \
+                       [a3M1] "w"(a3M1),                                                                               \
+                       [b0M1] "w"(b0M1),                                                                               \
+                       [b1M1] "w"(b1M1)                                                                                \
+                     : "memory");                                                                                      \
+    } while (0)
+#define MICRO_M(idx, ml, mc)                                                                                           \
+    do {                                                                                                               \
+        asm volatile("" ::: "memory");                                                                                 \
+        a0M##ml = svld1rq_s8(pg_all, &pa0[(idx) * 16]);                                                                \
+        b0M##ml = svld1_s8(pg_all, &pb0[(idx) * 32]);                                                                  \
+        b1M##ml = svld1_s8(pg_all, &pb1[(idx) * 32]);                                                                  \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc00s = svmmla_s32(acc00s, a0M##mc, b0M##mc);                                                                 \
+        acc01s = svmmla_s32(acc01s, a0M##mc, b1M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+        a1M##ml = svld1rq_s8(pg_all, &pa1[(idx) * 16]);                                                                \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc10s = svmmla_s32(acc10s, a1M##mc, b0M##mc);                                                                 \
+        acc11s = svmmla_s32(acc11s, a1M##mc, b1M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+        a2M##ml = svld1rq_s8(pg_all, &pa2[(idx) * 16]);                                                                \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc20s = svmmla_s32(acc20s, a2M##mc, b0M##mc);                                                                 \
+        acc21s = svmmla_s32(acc21s, a2M##mc, b1M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+        a3M##ml = svld1rq_s8(pg_all, &pa3[(idx) * 16]);                                                                \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc30s = svmmla_s32(acc30s, a3M##mc, b0M##mc);                                                                 \
+        acc31s = svmmla_s32(acc31s, a3M##mc, b1M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+    } while (0)
+#define MICRO_E                                                                                                        \
+    do {                                                                                                               \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc00s = svmmla_s32(acc00s, a0M2, b0M2);                                                                       \
+        acc01s = svmmla_s32(acc01s, a0M2, b1M2);                                                                       \
+        acc10s = svmmla_s32(acc10s, a1M2, b0M2);                                                                       \
+        acc11s = svmmla_s32(acc11s, a1M2, b1M2);                                                                       \
+        acc20s = svmmla_s32(acc20s, a2M2, b0M2);                                                                       \
+        acc21s = svmmla_s32(acc21s, a2M2, b1M2);                                                                       \
+        acc30s = svmmla_s32(acc30s, a3M2, b0M2);                                                                       \
+        acc31s = svmmla_s32(acc31s, a3M2, b1M2);                                                                       \
+        asm volatile("" ::: "memory");                                                                                 \
+    } while (0)
+                    MICRO_I;          // load1 load2 calc1
+                    MICRO_M(2, 1, 2); // load1 calc2
+                    MICRO_M(3, 2, 1); // load2 calc1
+                    MICRO_E;          // calc2
+                }
+
+                register svfloat32_t scale_a0 asm("z16") = svld1rq_f32(pg_all, &psa0[4 * ki]);
+                register svfloat32_t scale_a1 asm("z17") = svld1rq_f32(pg_all, &psa1[4 * ki]);
+                register svfloat32_t scale_a2 asm("z18") = svld1rq_f32(pg_all, &psa2[4 * ki]);
+                register svfloat32_t scale_a3 asm("z19") = svld1rq_f32(pg_all, &psa3[4 * ki]);
+                register svfloat32_t scale_b0 asm("z20") = svld1_f32(pg_all, &psb0[8 * ki]);
+                register svfloat32_t scale_b1 asm("z21") = svld1_f32(pg_all, &psb1[8 * ki]);
+
+#define MICRO_CVT_ACC(a, b)                                                                                            \
+    do {                                                                                                               \
+        asm volatile(                                                                                                  \
+          "scvtf %[accs].s, %[pg]/m, %[accs].s\n"                                                                      \
+          "fmul z31.s, %[scale_a].s, %[scale_b].s\n"                                                                   \
+          "fmla %[accf].s, %[pg]/m, %[accs].s, z31.s\n"                                                                \
+          : [accf] "+w"(acc##a##b##f)                                                                                  \
+          : [pg] "Upl"(pg_all), [accs] "w"(acc##a##b##s), [scale_a] "w"(scale_a##a), [scale_b] "w"(scale_b##b)         \
+          : "memory", "z31");                                                                                          \
+    } while (0)
+                MICRO_CVT_ACC(0, 0);
+                MICRO_CVT_ACC(0, 1);
+                MICRO_CVT_ACC(1, 0);
+                MICRO_CVT_ACC(1, 1);
+                MICRO_CVT_ACC(2, 0);
+                MICRO_CVT_ACC(2, 1);
+                MICRO_CVT_ACC(3, 0);
+                MICRO_CVT_ACC(3, 1);
+#undef MICRO_CVT_ACC
+            }
+#define STORE_C(a, b)                                                                                                  \
+    do {                                                                                                               \
+        svfloat32_t acc_tbl = svtbl_f32((acc##a##b##f), acc_table);                                                    \
+        svuint64_t acc_b64 = svreinterpret_u64_f32(acc_tbl);                                                           \
+        svst1_scatter_u64index_u64(                                                                                    \
+          pg_all, (uint64_t*)&C[((i + (b * 4)) * c_stride) + (j + (a * 2))], indices_storage_b64, acc_b64);            \
+    } while (0)
+            STORE_C(0, 0);
+            STORE_C(0, 1);
+            STORE_C(1, 0);
+            STORE_C(1, 1);
+            STORE_C(2, 0);
+            STORE_C(2, 1);
+            STORE_C(3, 0);
+            STORE_C(3, 1);
+#undef STORE_C
+        }
+    }
+}
+
+void
+matmul_q8_0_mmla_4x4_b_micro_spack_neon(size_t M,
+                                        size_t N,
+                                        size_t K,
+                                        const matmul_q8_0_mmla_spack_t* pack_a,
+                                        const matmul_q8_0_mmla_spack_t* pack_b,
+                                        void* GGML_RESTRICT c,
+                                        size_t c_column_bytes)
+{
+    GGML_ASSERT(M == 4);
+    GGML_ASSERT(N == 4);
+
+    const size_t K_Q8_0 = (K + QK8_0 - 1) / QK8_0;
+
+    float32_t * GGML_RESTRICT C = (float32_t *) c;
+    const size_t c_stride = c_column_bytes / sizeof(float32_t);
+
+    // NEON int32x4_t 只能表达 2x2。
+    // SVE 256-bit 一个 acc 覆盖 2x4，这里拆成两个 2x2：
+    // acc00: rows 0,1 x cols 0,1
+    // acc01: rows 0,1 x cols 2,3
+    // acc10: rows 2,3 x cols 0,1
+    // acc11: rows 2,3 x cols 2,3
+
+    float32x4_t acc00f = {
+        C[0 * c_stride + 0],
+        C[1 * c_stride + 0],
+        C[0 * c_stride + 1],
+        C[1 * c_stride + 1],
+    };
+
+    float32x4_t acc01f = {
+        C[2 * c_stride + 0],
+        C[3 * c_stride + 0],
+        C[2 * c_stride + 1],
+        C[3 * c_stride + 1],
+    };
+
+    float32x4_t acc10f = {
+        C[0 * c_stride + 2],
+        C[1 * c_stride + 2],
+        C[0 * c_stride + 3],
+        C[1 * c_stride + 3],
+    };
+
+    float32x4_t acc11f = {
+        C[2 * c_stride + 2],
+        C[3 * c_stride + 2],
+        C[2 * c_stride + 3],
+        C[3 * c_stride + 3],
+    };
+
+    const float32_t * psa0 = &pack_a->scale[(0 + 2 * 0) * pack_a->scale_stride * 2];
+    const float32_t * psa1 = &pack_a->scale[(0 + 2 * 1) * pack_a->scale_stride * 2];
+
+    const float32_t * psb0 = &pack_b->scale[(0 + 4 * 0) * pack_b->scale_stride * 2];
+
+    const int8_t * pap0 = &pack_a->p[(0 + 0 * 2) * pack_a->p_stride];
+    const int8_t * pap1 = &pack_a->p[(0 + 1 * 2) * pack_a->p_stride];
+
+    const int8_t * pbp0 = &pack_b->p[(0 + 0 * 4) * pack_b->p_stride];
+
+    for (size_t ki = 0; ki < K_Q8_0; ++ki) {
+        int32x4_t acc00s = vdupq_n_s32(0);
+        int32x4_t acc01s = vdupq_n_s32(0);
+        int32x4_t acc10s = vdupq_n_s32(0);
+        int32x4_t acc11s = vdupq_n_s32(0);
+
+        const int8_t * pa0 = &pap0[ki * QK8_0 * 2];
+        const int8_t * pa1 = &pap1[ki * QK8_0 * 2];
+        const int8_t * pb0 = &pbp0[ki * QK8_0 * 4];
+
+        // 每个 idx 覆盖 8 个 K 元素。
+        // A: 16B = 2 rows x 8 K
+        // B: 32B = 4 cols x 8 K
+        // NEON vmmla 一次只能吃 B 的 2 列，所以 B 拆成：
+        //   b01 = cols 0,1
+        //   b23 = cols 2,3
+        for (size_t idx = 0; idx < 4; ++idx) {
+            const int8x16_t a0  = vld1q_s8(pa0 + idx * 16);
+            const int8x16_t a1  = vld1q_s8(pa1 + idx * 16);
+
+            const int8x16_t b01 = vld1q_s8(pb0 + idx * 32 + 0);
+            const int8x16_t b23 = vld1q_s8(pb0 + idx * 32 + 16);
+
+            acc00s = vmmlaq_s32(acc00s, a0, b01);
+            acc01s = vmmlaq_s32(acc01s, a0, b23);
+            acc10s = vmmlaq_s32(acc10s, a1, b01);
+            acc11s = vmmlaq_s32(acc11s, a1, b23);
+        }
+
+        // A scale:
+        // psa0[4*ki + 0..3] = row0,row0,row1,row1
+        // psa1[4*ki + 0..3] = row2,row2,row3,row3
+        const float32x4_t scale_a0 = vld1q_f32(&psa0[4 * ki]);
+        const float32x4_t scale_a1 = vld1q_f32(&psa1[4 * ki]);
+
+        // B scale pack:
+        // psb0[8*ki + 0..7] = b0,b1,b0,b1,b2,b3,b2,b3
+        const float32x4_t scale_b01 = vld1q_f32(&psb0[8 * ki + 0]);
+        const float32x4_t scale_b23 = vld1q_f32(&psb0[8 * ki + 4]);
+
+        acc00f = vfmaq_f32(
+            acc00f,
+            vcvtq_f32_s32(acc00s),
+            vmulq_f32(scale_a0, scale_b01));
+
+        acc01f = vfmaq_f32(
+            acc01f,
+            vcvtq_f32_s32(acc01s),
+            vmulq_f32(scale_a0, scale_b23));
+
+        acc10f = vfmaq_f32(
+            acc10f,
+            vcvtq_f32_s32(acc10s),
+            vmulq_f32(scale_a1, scale_b01));
+
+        acc11f = vfmaq_f32(
+            acc11f,
+            vcvtq_f32_s32(acc11s),
+            vmulq_f32(scale_a1, scale_b23));
+    }
+
+#define STORE_2X2(acc, row_base, col_base)                                      \
+    do {                                                                        \
+        float tmp[4];                                                           \
+        vst1q_f32(tmp, (acc));                                                  \
+        C[(col_base + 0) * c_stride + (row_base + 0)] = tmp[0];                 \
+        C[(col_base + 1) * c_stride + (row_base + 0)] = tmp[1];                 \
+        C[(col_base + 0) * c_stride + (row_base + 1)] = tmp[2];                 \
+        C[(col_base + 1) * c_stride + (row_base + 1)] = tmp[3];                 \
+    } while (0)
+
+    STORE_2X2(acc00f, 0, 0);
+    STORE_2X2(acc01f, 0, 2);
+    STORE_2X2(acc10f, 2, 0);
+    STORE_2X2(acc11f, 2, 2);
+
+#undef STORE_2X2
+}
+
+void
+matmul_q8_0_mmla_4x4_b_micro_spack(size_t M,
+                                   size_t N,
+                                   size_t K,
+                                   const matmul_q8_0_mmla_spack_t* pack_a,
+                                   const matmul_q8_0_mmla_spack_t* pack_b,
+                                   void* GGML_RESTRICT c,
+                                   size_t c_column_bytes)
+{
+    // fprintf(stderr, "M=%zu,N=%zu,K=%zu\n", M, N, K);
+
+    // 这个 kernel 只吃 4x4 整块
+    GGML_ASSERT(M == 4);
+    GGML_ASSERT(N == 4);
+
+    const size_t K_Q8_0 = (K + QK8_0 - 1) / QK8_0;
+
+    register svfloat32_t acc00f asm("z0");
+    register svfloat32_t acc10f asm("z1");
+
+    svbool_t pg_all = svptrue_b8();
+
+    float32_t * GGML_RESTRICT C = (float32_t *) c;
+    const size_t c_stride = c_column_bytes / sizeof(float32_t);
+
+    const static uint32_t acc_table_v[8] = { 0, 2, 1, 3, 4, 6, 5, 7 };
+    const static uint64_t zero_x[8] = { 0 };
+
+    for (size_t i = 0; i < N; i += 4) {
+        for (size_t j = 0; j < M; j += 4) {
+            svuint32_t acc_table = svld1_u32(pg_all, acc_table_v);
+            svuint64_t indices_storage_b64 = svindex_u64(0, c_stride / 2);
+
+#define LOAD_C_4x4(a)                                                                                                  \
+    do {                                                                                                               \
+        svfloat32_t acc_tmp = svreinterpret_f32_u64(                                                                   \
+          svld1_gather_u64index_u64(                                                                                   \
+            pg_all,                                                                                                    \
+            (uint64_t*)&C[(i * c_stride) + (j + (a * 2))],                                                            \
+            indices_storage_b64));                                                                                     \
+        (acc##a##0f) = svtbl_f32(acc_tmp, acc_table);                                                                  \
+    } while (0)
+
+            LOAD_C_4x4(0);
+            LOAD_C_4x4(1);
+
+#undef LOAD_C_4x4
+
+            // A: 只保留两组 2-row
+            const float32_t * psa0 = &pack_a->scale[(j + 2 * 0) * pack_a->scale_stride * 2];
+            const float32_t * psa1 = &pack_a->scale[(j + 2 * 1) * pack_a->scale_stride * 2];
+
+            // B: 只保留一组 4-col
+            const float32_t * psb0 = &pack_b->scale[(i + 4 * 0) * pack_b->scale_stride * 2];
+
+            const int8_t * pap0 = &pack_a->p[(j + 0 * 2) * pack_a->p_stride];
+            const int8_t * pap1 = &pack_a->p[(j + 1 * 2) * pack_a->p_stride];
+
+            const int8_t * pbp0 = &pack_b->p[(i + 0 * 4) * pack_b->p_stride];
+
+            for (size_t ki = 0; ki < K_Q8_0; ++ki) {
+                register svint32_t acc00s asm("z8");
+                register svint32_t acc10s asm("z9");
+
+#define LOAD_ZERO(acc)                                                                                                 \
+    asm volatile("ld1rb { %[zt].b }, %[pg]/z, [%[zero]]\n"                                                             \
+                 : [zt] "=w"((acc))                                                                                    \
+                 : [pg] "Upl"(pg_all), [zero] "r"(&zero_x[0])                                                          \
+                 : "memory")
+
+                LOAD_ZERO(acc00s);
+                LOAD_ZERO(acc10s);
+
+#undef LOAD_ZERO
+
+                const int8_t * pa0 = &pap0[ki * QK8_0 * 2];
+                const int8_t * pa1 = &pap1[ki * QK8_0 * 2];
+                const int8_t * pb0 = &pbp0[ki * QK8_0 * 4];
+
+
+                {
+                    register svint8_t a0M1 asm("z16");
+                    register svint8_t a1M1 asm("z17");
+                    register svint8_t b0M1 asm("z18");
+
+                    register svint8_t a0M2 asm("z19");
+                    register svint8_t a1M2 asm("z20");
+                    register svint8_t b0M2 asm("z21");
+
+#define MICRO_I                                                                                                        \
+    do {                                                                                                               \
+        asm volatile("ld1rqb { %[a0M1].b }, %[pg]/z, [%[pa0], #(0 * 16)]\n"                                            \
+                     "ld1rqb { %[a1M1].b }, %[pg]/z, [%[pa1], #(0 * 16)]\n"                                            \
+                     "ld1b   { %[b0M1].b }, %[pg]/z, [%[pb0], #0, mul vl]\n"                                           \
+                     : [a0M1] "=w"(a0M1),                                                                              \
+                       [a1M1] "=w"(a1M1),                                                                              \
+                       [b0M1] "=w"(b0M1)                                                                               \
+                     : [pg] "Upl"(pg_all),                                                                             \
+                       [pa0] "r"(pa0),                                                                                 \
+                       [pa1] "r"(pa1),                                                                                 \
+                       [pb0] "r"(pb0)                                                                                  \
+                     : "memory");                                                                                      \
+        asm volatile("ld1rqb { %[a0M2].b }, %[pg]/z, [%[pa0], #(1 * 16)]\n"                                            \
+                     "ld1rqb { %[a1M2].b }, %[pg]/z, [%[pa1], #(1 * 16)]\n"                                            \
+                     "ld1b   { %[b0M2].b }, %[pg]/z, [%[pb0], #1, mul vl]\n"                                           \
+                     : [a0M2] "=w"(a0M2),                                                                              \
+                       [a1M2] "=w"(a1M2),                                                                              \
+                       [b0M2] "=w"(b0M2)                                                                               \
+                     : [pg] "Upl"(pg_all),                                                                             \
+                       [pa0] "r"(pa0),                                                                                 \
+                       [pa1] "r"(pa1),                                                                                 \
+                       [pb0] "r"(pb0)                                                                                  \
+                     : "memory");                                                                                      \
+        asm volatile("smmla %[acc00s].s, %[a0M1].b, %[b0M1].b\n"                                                       \
+                     "smmla %[acc10s].s, %[a1M1].b, %[b0M1].b\n"                                                       \
+                     : [acc00s] "+w"(acc00s),                                                                          \
+                       [acc10s] "+w"(acc10s)                                                                           \
+                     : [a0M1] "w"(a0M1),                                                                               \
+                       [a1M1] "w"(a1M1),                                                                               \
+                       [b0M1] "w"(b0M1)                                                                                \
+                     : "memory");                                                                                      \
+    } while (0)
+
+#define MICRO_M(idx, ml, mc)                                                                                           \
+    do {                                                                                                               \
+        asm volatile("" ::: "memory");                                                                                 \
+        a0M##ml = svld1rq_s8(pg_all, &pa0[(idx) * 16]);                                                                \
+        b0M##ml = svld1_s8(pg_all, &pb0[(idx) * 32]);                                                                  \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc00s = svmmla_s32(acc00s, a0M##mc, b0M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+        a1M##ml = svld1rq_s8(pg_all, &pa1[(idx) * 16]);                                                                \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc10s = svmmla_s32(acc10s, a1M##mc, b0M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+    } while (0)
+
+#define MICRO_E                                                                                                        \
+    do {                                                                                                               \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc00s = svmmla_s32(acc00s, a0M2, b0M2);                                                                       \
+        acc10s = svmmla_s32(acc10s, a1M2, b0M2);                                                                       \
+        asm volatile("" ::: "memory");                                                                                 \
+    } while (0)
+
+                    MICRO_I;
+                    MICRO_M(2, 1, 2);
+                    MICRO_M(3, 2, 1);
+                    MICRO_E;
+
+#undef MICRO_I
+#undef MICRO_M
+#undef MICRO_E
+                }
+
+                register svfloat32_t scale_a0 asm("z16") = svld1rq_f32(pg_all, &psa0[4 * ki]);
+                register svfloat32_t scale_a1 asm("z17") = svld1rq_f32(pg_all, &psa1[4 * ki]);
+
+                // 这里先沿用 8x4 那版思路；如果你的 B scale pack 每个 ki 实际 stride 仍是 8，
+                // 这里要改成 &psb0[8 * ki]
+                register svfloat32_t scale_b0 asm("z18") = svld1_f32(pg_all, &psb0[8 * ki]);
+
+#define MICRO_CVT_ACC(a)                                                                                               \
+    do {                                                                                                               \
+        asm volatile(                                                                                                  \
+          "scvtf %[accs].s, %[pg]/m, %[accs].s\n"                                                                      \
+          "fmul z31.s, %[scale_a].s, %[scale_b].s\n"                                                                   \
+          "fmla %[accf].s, %[pg]/m, %[accs].s, z31.s\n"                                                                \
+          : [accf] "+w"(acc##a##0f)                                                                                    \
+          : [pg] "Upl"(pg_all),                                                                                        \
+            [accs] "w"(acc##a##0s),                                                                                    \
+            [scale_a] "w"(scale_a##a),                                                                                 \
+            [scale_b] "w"(scale_b0)                                                                                    \
+          : "memory", "z31");                                                                                          \
+    } while (0)
+
+                MICRO_CVT_ACC(0);
+                MICRO_CVT_ACC(1);
+
+#undef MICRO_CVT_ACC
+            }
+
+#define STORE_C_4x4(a)                                                                                                 \
+    do {                                                                                                               \
+        svfloat32_t acc_tbl = svtbl_f32((acc##a##0f), acc_table);                                                      \
+        svuint64_t acc_b64 = svreinterpret_u64_f32(acc_tbl);                                                           \
+        svst1_scatter_u64index_u64(                                                                                    \
+          pg_all,                                                                                                      \
+          (uint64_t*)&C[(i * c_stride) + (j + (a * 2))],                                                              \
+          indices_storage_b64,                                                                                         \
+          acc_b64);                                                                                                    \
+    } while (0)
+
+            STORE_C_4x4(0);
+            STORE_C_4x4(1);
+
+#undef STORE_C_4x4
+        }
+    }
+
+}
+void
+matmul_q8_0_mmla_4x4_tiled_padded(size_t na_real,
+                                  size_t nb_real,
+                                  size_t na_pad,
+                                  size_t nb_pad,
+                                  size_t k,
+                                  size_t m,
+                                  size_t n,
+                                  size_t kb,
+                                  const block_q8_0 * GGML_RESTRICT A,
+                                  const block_q8_0 * GGML_RESTRICT B,
+                                  size_t a_stride_q_0,
+                                  size_t b_stride_q_0,
+                                  size_t a_column_bytes,
+                                  size_t b_column_bytes,
+                                  float * GGML_RESTRICT tmp_c,
+                                  matmul_q8_0_mmla_spack_t ** pack_a_tile_io,
+                                  matmul_q8_0_mmla_spack_t ** pack_b_tile_io)
+{
+    for (size_t nn = 0; nn < nb_pad; nn += 4) {
+        const size_t nb_tile_real = (nn < nb_real) ? MIN((size_t)4, nb_real - nn) : 0;
+        const block_q8_0 * B_sub = &B[(n + nn) * b_stride_q_0 + kb];
+
+        matmul_q8_0_mmla_spack_padded(
+            false,
+            nb_tile_real,
+            4,
+            (int)k,
+            B_sub,
+            b_column_bytes,
+            pack_b_tile_io);
+
+        for (size_t mm = 0; mm < na_pad; mm += 4) {
+            const size_t na_tile_real = (mm < na_real) ? MIN((size_t)4, na_real - mm) : 0;
+            const block_q8_0 * A_sub = &A[(m + mm) * a_stride_q_0 + kb];
+
+            matmul_q8_0_mmla_spack_padded(
+                true,
+                na_tile_real,
+                4,
+                (int)k,
+                A_sub,
+                a_column_bytes,
+                pack_a_tile_io);
+
+            matmul_q8_0_mmla_4x4_b_micro_spack(
+                4, 4, k,
+                *pack_a_tile_io,
+                *pack_b_tile_io,
+                &tmp_c[nn * na_pad + mm],
+                na_pad * sizeof(float));
+        }
+    }
+}
+void
+matmul_q8_0_mmla_mask_b_micro_spack(size_t M,
+                                    size_t N,
+                                    size_t K,
+                                    const matmul_q8_0_mmla_spack_t* pack_a,
+                                    const matmul_q8_0_mmla_spack_t* pack_b,
+                                    void* GGML_RESTRICT c,
+                                    size_t c_column_bytes)
+{
+    // fprintf(stderr, "MASK M=%zu,N=%zu,K=%zu\n", M, N, K);
+
+    assert(M >= 1 && M <= 4);
+    assert(N >= 1 && N <= 4);
+
+    const size_t K_Q8_0 = (K + QK8_0 - 1) / QK8_0;
+
+    register svfloat32_t acc00f asm("z0");
+    register svfloat32_t acc10f asm("z1");
+
+    svbool_t pg_all = svptrue_b8();
+    svbool_t pg_m32 = svwhilelt_b32((uint64_t)0, (uint64_t)M);
+
+    float32_t* GGML_RESTRICT C = (float32_t*)(c);
+    const size_t c_stride = c_column_bytes / sizeof(float32_t);
+
+    // 本地 4x4 scratch，按列主序语义访问：tmp[col][row]
+    float tmp_c[4][4] __attribute__((aligned(64)));
+
+    const static uint32_t acc_table_v[8] = { 0, 2, 1, 3, 4, 6, 5, 7 };
+    const static uint64_t zero_x[8] = { 0 };
+
+    // ------------------------------------------------------------
+    // 1) masked load C -> tmp_c，invalid 区域置 0
+    // ------------------------------------------------------------
+    for (size_t col = 0; col < 4; ++col) {
+        for (size_t row = 0; row < 4; ++row) {
+            tmp_c[col][row] = 0.0f;
+        }
+    }
+
+    for (size_t col = 0; col < N; ++col) {
+        svfloat32_t v = svld1(pg_m32, &C[col * c_stride]);
+        svst1(pg_m32, &tmp_c[col][0], v);
+    }
+
+    // ------------------------------------------------------------
+    // 2) 计算一个完整 4x4 tile 到 tmp_c
+    // ------------------------------------------------------------
+    {
+        svuint32_t acc_table = svld1_u32(pg_all, acc_table_v);
+        svuint64_t indices_storage_b64 = svindex_u64(0, 2); // scratch stride 固定是 4 float => /2 = 2
+
+#define LOAD_C_4x4_TMP(a)                                                                                              \
+    do {                                                                                                               \
+        svfloat32_t acc_tmp = svreinterpret_f32_u64(                                                                   \
+          svld1_gather_u64index_u64(                                                                                   \
+            pg_all,                                                                                                    \
+            (uint64_t*)&tmp_c[0][(a) * 2],                                                                            \
+            indices_storage_b64));                                                                                     \
+        (acc##a##0f) = svtbl_f32(acc_tmp, acc_table);                                                                  \
+    } while (0)
+
+        LOAD_C_4x4_TMP(0);
+        LOAD_C_4x4_TMP(1);
+
+#undef LOAD_C_4x4_TMP
+
+        // A: 两组 2-row
+        const float32_t* psa0 = &pack_a->scale[(0 + 2 * 0) * pack_a->scale_stride * 2];
+        const float32_t* psa1 = &pack_a->scale[(0 + 2 * 1) * pack_a->scale_stride * 2];
+
+        // B: 一组 4-col
+        const float32_t* psb0 = &pack_b->scale[(0 + 4 * 0) * pack_b->scale_stride * 2];
+
+        const int8_t* pap0 = &pack_a->p[(0 + 0 * 2) * pack_a->p_stride];
+        const int8_t* pap1 = &pack_a->p[(0 + 1 * 2) * pack_a->p_stride];
+        const int8_t* pbp0 = &pack_b->p[(0 + 0 * 4) * pack_b->p_stride];
+
+        for (size_t ki = 0; ki < K_Q8_0; ++ki) {
+            register svint32_t acc00s asm("z8");
+            register svint32_t acc10s asm("z9");
+
+#define LOAD_ZERO(acc)                                                                                                 \
+    asm volatile("ld1rb { %[zt].b }, %[pg]/z, [%[zero]]\n"                                                             \
+                 : [zt] "=w"((acc))                                                                                    \
+                 : [pg] "Upl"(pg_all), [zero] "r"(&zero_x[0])                                                          \
+                 : "memory")
+
+            LOAD_ZERO(acc00s);
+            LOAD_ZERO(acc10s);
+
+#undef LOAD_ZERO
+
+            const int8_t* pa0 = &pap0[ki * QK8_0 * 2];
+            const int8_t* pa1 = &pap1[ki * QK8_0 * 2];
+            const int8_t* pb0 = &pbp0[ki * QK8_0 * 4];
+
+            {
+                register svint8_t a0M1 asm("z16");
+                register svint8_t a1M1 asm("z17");
+                register svint8_t b0M1 asm("z18");
+
+                register svint8_t a0M2 asm("z19");
+                register svint8_t a1M2 asm("z20");
+                register svint8_t b0M2 asm("z21");
+
+#define MICRO_I                                                                                                        \
+    do {                                                                                                               \
+        asm volatile("ld1rqb { %[a0M1].b }, %[pg]/z, [%[pa0], #(0 * 16)]\n"                                            \
+                     "ld1rqb { %[a1M1].b }, %[pg]/z, [%[pa1], #(0 * 16)]\n"                                            \
+                     "ld1b   { %[b0M1].b }, %[pg]/z, [%[pb0], #0, mul vl]\n"                                           \
+                     : [a0M1] "=w"(a0M1),                                                                              \
+                       [a1M1] "=w"(a1M1),                                                                              \
+                       [b0M1] "=w"(b0M1)                                                                               \
+                     : [pg] "Upl"(pg_all),                                                                             \
+                       [pa0] "r"(pa0),                                                                                 \
+                       [pa1] "r"(pa1),                                                                                 \
+                       [pb0] "r"(pb0)                                                                                  \
+                     : "memory");                                                                                      \
+        asm volatile("ld1rqb { %[a0M2].b }, %[pg]/z, [%[pa0], #(1 * 16)]\n"                                            \
+                     "ld1rqb { %[a1M2].b }, %[pg]/z, [%[pa1], #(1 * 16)]\n"                                            \
+                     "ld1b   { %[b0M2].b }, %[pg]/z, [%[pb0], #1, mul vl]\n"                                           \
+                     : [a0M2] "=w"(a0M2),                                                                              \
+                       [a1M2] "=w"(a1M2),                                                                              \
+                       [b0M2] "=w"(b0M2)                                                                               \
+                     : [pg] "Upl"(pg_all),                                                                             \
+                       [pa0] "r"(pa0),                                                                                 \
+                       [pa1] "r"(pa1),                                                                                 \
+                       [pb0] "r"(pb0)                                                                                  \
+                     : "memory");                                                                                      \
+        asm volatile("smmla %[acc00s].s, %[a0M1].b, %[b0M1].b\n"                                                       \
+                     "smmla %[acc10s].s, %[a1M1].b, %[b0M1].b\n"                                                       \
+                     : [acc00s] "+w"(acc00s),                                                                          \
+                       [acc10s] "+w"(acc10s)                                                                           \
+                     : [a0M1] "w"(a0M1),                                                                               \
+                       [a1M1] "w"(a1M1),                                                                               \
+                       [b0M1] "w"(b0M1)                                                                                \
+                     : "memory");                                                                                      \
+    } while (0)
+
+#define MICRO_M(idx, ml, mc)                                                                                           \
+    do {                                                                                                               \
+        asm volatile("" ::: "memory");                                                                                 \
+        a0M##ml = svld1rq_s8(pg_all, &pa0[(idx) * 16]);                                                                \
+        b0M##ml = svld1_s8(pg_all, &pb0[(idx) * 32]);                                                                  \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc00s = svmmla_s32(acc00s, a0M##mc, b0M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+        a1M##ml = svld1rq_s8(pg_all, &pa1[(idx) * 16]);                                                                \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc10s = svmmla_s32(acc10s, a1M##mc, b0M##mc);                                                                 \
+        asm volatile("" ::: "memory");                                                                                 \
+    } while (0)
+
+#define MICRO_E                                                                                                        \
+    do {                                                                                                               \
+        asm volatile("" ::: "memory");                                                                                 \
+        acc00s = svmmla_s32(acc00s, a0M2, b0M2);                                                                       \
+        acc10s = svmmla_s32(acc10s, a1M2, b0M2);                                                                       \
+        asm volatile("" ::: "memory");                                                                                 \
+    } while (0)
+
+                MICRO_I;
+                MICRO_M(2, 1, 2);
+                MICRO_M(3, 2, 1);
+                MICRO_E;
+
+#undef MICRO_I
+#undef MICRO_M
+#undef MICRO_E
+            }
+
+            register svfloat32_t scale_a0 asm("z16") = svld1rq_f32(pg_all, &psa0[4 * ki]);
+            register svfloat32_t scale_a1 asm("z17") = svld1rq_f32(pg_all, &psa1[4 * ki]);
+
+            // 这里先沿用 4x4 kernel 当前假设；
+            // 如果你的 B scale pack 实际每个 ki stride 是 8，这里改成 &psb0[8 * ki]
+            register svfloat32_t scale_b0 asm("z18") = svld1_f32(pg_all, &psb0[8 * ki]);
+
+#define MICRO_CVT_ACC(a)                                                                                               \
+    do {                                                                                                               \
+        asm volatile(                                                                                                  \
+          "scvtf %[accs].s, %[pg]/m, %[accs].s\n"                                                                      \
+          "fmul z31.s, %[scale_a].s, %[scale_b].s\n"                                                                   \
+          "fmla %[accf].s, %[pg]/m, %[accs].s, z31.s\n"                                                                \
+          : [accf] "+w"(acc##a##0f)                                                                                    \
+          : [pg] "Upl"(pg_all),                                                                                        \
+            [accs] "w"(acc##a##0s),                                                                                    \
+            [scale_a] "w"(scale_a##a),                                                                                 \
+            [scale_b] "w"(scale_b0)                                                                                    \
+          : "memory", "z31");                                                                                          \
+    } while (0)
+
+            MICRO_CVT_ACC(0);
+            MICRO_CVT_ACC(1);
+
+#undef MICRO_CVT_ACC
+        }
+
+#define STORE_C_4x4_TMP(a)                                                                                             \
+    do {                                                                                                               \
+        svfloat32_t acc_tbl = svtbl_f32((acc##a##0f), acc_table);                                                      \
+        svuint64_t acc_b64 = svreinterpret_u64_f32(acc_tbl);                                                           \
+        svst1_scatter_u64index_u64(                                                                                    \
+          pg_all,                                                                                                      \
+          (uint64_t*)&tmp_c[0][(a) * 2],                                                                              \
+          indices_storage_b64,                                                                                         \
+          acc_b64);                                                                                                    \
+    } while (0)
+
+        STORE_C_4x4_TMP(0);
+        STORE_C_4x4_TMP(1);
+
+#undef STORE_C_4x4_TMP
+    }
+
+    // ------------------------------------------------------------
+    // 3) masked store tmp_c -> C
+    // ------------------------------------------------------------
+    for (size_t col = 0; col < N; ++col) {
+        svfloat32_t v = svld1(pg_m32, &tmp_c[col][0]);
+        svst1(pg_m32, &C[col * c_stride], v);
+    }
+
+}
+
+
+static inline void
+matmul_q8_0_mmla_spack_make_row_view(
+    const struct matmul_q8_0_mmla_spack_t * src,
+    size_t row,
+    struct matmul_q8_0_mmla_spack_t * dst)
+{
+    *dst = *src;
+    dst->p     = src->p     + row * src->p_stride;
+    dst->scale = src->scale + row * src->scale_stride * 2;
+}
+
+static inline void
+matmul_q8_0_mmla_spack_make_col_view(
+    const struct matmul_q8_0_mmla_spack_t * src,
+    size_t col,
+    struct matmul_q8_0_mmla_spack_t * dst)
+{
+    *dst = *src;
+    dst->p     = src->p     + col * src->p_stride;
+    dst->scale = src->scale + col * src->scale_stride * 2;
+}
+
+static inline float *
+matmul_f32_tile_ptr(void * GGML_RESTRICT c,
+                    size_t c_column_bytes,
+                    size_t row,
+                    size_t col)
+{
+    float * C = (float *) c;
+    const size_t c_stride = c_column_bytes / sizeof(float);
+    return &C[col * c_stride + row];
+}
