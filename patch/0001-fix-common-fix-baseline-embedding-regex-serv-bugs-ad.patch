From 8b639de1dbab6baee353fdbbcaa6e1cdfd6d1e22 Mon Sep 17 00:00:00 2001
From: Kaixin Liu <liukaixin1@h-partners.com>
Date: Thu, 6 Aug 2026 16:18:45 +0800
Subject: [PATCH 01/11] fix(common): fix baseline embedding/regex serv bugs,
 add debug infra

- common_embd_normalize: keep double-precision accumulation to avoid
  fp32 overflow on long sequences; add omp simd reductions
- common_embd_similarity_cos: use double accumulation
- common: link OpenMP when GGML_OPENMP is on (needed by omp simd)
- tools/server: fix trailing whitespace in embedding output path,
  add reserve() helper used for embedding buffers
- llama-model: name BERT intermediate tensors (L*_attn_out etc.) for debugging
- llama-context: add gated tensor-dump block for precision debugging
  (disabled by default, requires LLAMA_DUMP_DIR)
---
 common/CMakeLists.txt   |   7 ++
 common/common.cpp       |  14 ++--
 src/llama-context.cpp   | 140 ++++++++++++++++++++++++++++++++++++++++
 src/llama-model.cpp     |   6 ++
 tools/server/server.cpp |   2 +-
 tools/server/utils.hpp  |   4 ++
 6 files changed, 167 insertions(+), 6 deletions(-)

diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index 564af144..101997bf 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -148,6 +148,13 @@ target_include_directories(${TARGET} PUBLIC . ../vendor)
 target_compile_features   (${TARGET} PUBLIC cxx_std_17)
 target_link_libraries     (${TARGET} PRIVATE ${LLAMA_COMMON_EXTRA_LIBS} PUBLIC llama Threads::Threads)
 
+if (GGML_OPENMP)
+    find_package(OpenMP)
+    if (OpenMP_FOUND)
+        target_link_libraries(${TARGET} PRIVATE OpenMP::OpenMP_CXX)
+    endif()
+endif()
+
 
 #
 # copy the license files
diff --git a/common/common.cpp b/common/common.cpp
index 4cc40ed8..3430ad95 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1346,6 +1346,7 @@ void common_embd_normalize(const float * inp, float * out, int n, int embd_norm)
             sum = 1.0;
             break;
         case 0: // max absolute
+            #pragma omp simd reduction(max:sum)
             for (int i = 0; i < n; i++) {
                 if (sum < std::abs(inp[i])) {
                     sum = std::abs(inp[i]);
@@ -1354,8 +1355,9 @@ void common_embd_normalize(const float * inp, float * out, int n, int embd_norm)
             sum /= 32760.0; // make an int16 range
             break;
         case 2: // euclidean
+            #pragma omp simd reduction(+:sum)
             for (int i = 0; i < n; i++) {
-                sum += inp[i] * inp[i];
+                sum += (double)inp[i] * inp[i];
             }
             sum = std::sqrt(sum);
             break;
@@ -1367,8 +1369,9 @@ void common_embd_normalize(const float * inp, float * out, int n, int embd_norm)
             break;
     }
 
-    const float norm = sum > 0.0 ? 1.0 / sum : 0.0f;
+    const float norm = sum > 0.0 ? (float)(1.0 / sum) : 0.0f;
 
+    #pragma omp simd
     for (int i = 0; i < n; i++) {
         out[i] = inp[i] * norm;
     }
@@ -1379,10 +1382,11 @@ float common_embd_similarity_cos(const float * embd1, const float * embd2, int n
     double sum1 = 0.0;
     double sum2 = 0.0;
 
+    #pragma omp simd reduction(+:sum,sum1,sum2)
     for (int i = 0; i < n; i++) {
-        sum  += embd1[i] * embd2[i];
-        sum1 += embd1[i] * embd1[i];
-        sum2 += embd2[i] * embd2[i];
+        sum  += (double)embd1[i] * embd2[i];
+        sum1 += (double)embd1[i] * embd1[i];
+        sum2 += (double)embd2[i] * embd2[i];
     }
 
     // Handle the case where one or both vectors are zero vectors
