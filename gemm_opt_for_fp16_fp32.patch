+static void compute_forward_mul_mat_one_chunk_matmul_kernel_fp32(
+    const struct ggml_compute_params * params,
+    struct ggml_tensor * dst,
+    const enum ggml_type type,
+    const int64_t ir0_start,
+    const int64_t ir0_end,
+    const int64_t ir1_start,
+    const int64_t ir1_end) {
+
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const bool src1_cont = ggml_is_contiguous(src1);
+
+    ggml_vec_dot_t const vec_dot      = type_traits_cpu[type].vec_dot;
+    enum ggml_type const vec_dot_type = type_traits_cpu[type].vec_dot_type;
+
+    // broadcast factors
+    const int64_t r2 = ne12 / ne02;
+    const int64_t r3 = ne13 / ne03;
+
+    // threads with no work simply yield (not sure if it helps)
+    if (ir0_start >= ir0_end || ir1_start >= ir1_end) {
+        return;
+    }
+
+    const void * wdata = (src1->type == vec_dot_type) ? src1->data : params->wdata;
+    const size_t row_size = ggml_row_size(vec_dot_type, ne10);
+
+    assert(ne12 % ne02 == 0);
+    assert(ne13 % ne03 == 0);
+
+    // block-tiling attempt
+    const int64_t blck_0 = 4;
+    const int64_t blck_1 = 4;
+    for (int64_t iir1 = ir1_start; iir1 < ir1_end; iir1 += blck_1) {
+        for (int64_t iir0 = ir0_start; iir0 < ir0_end; iir0 += blck_0) {
+            // handle leftovers using vec_dot
+            if (iir1 + blck_1 > ir1_end || iir0 + blck_0 > ir0_end) {
+                for (int64_t ir1 = iir1; ir1 < iir1 + blck_1 && ir1 < ir1_end; ir1 += 1) {
+                    const int64_t i13 = (ir1 / (ne12 * ne1));
+                    const int64_t i12 = (ir1 - i13 * ne12 * ne1) / ne1;
+                    const int64_t i11 = (ir1 - i13 * ne12 * ne1 - i12 * ne1);
+
+                    // broadcast src0 into src1
+                    const int64_t i03 = i13 / r3;
+                    const int64_t i02 = i12 / r2;
+
+                    const int64_t i1 = i11;
+                    const int64_t i2 = i12;
+                    const int64_t i3 = i13;
+
+                    const char * src0_row = (const char*)src0->data + (0 + i02 * nb02 + i03 * nb03);
+                    float * dst_col = (float*)((char*)dst->data + (i1 * nb1 + i2 * nb2 + i3 * nb3));
+
+                    const char * src1_col = src1_cont ?
+                        ((const char*)wdata + (i11 + i12 * ne11 + i13 * ne12 * ne11) * row_size):
+                        ((const char*)wdata + (i11 * nb11 + i12 * nb12 + i13 * nb13));
+
+                    for (int64_t ir0 = iir0; ir0 < iir0 + blck_0 && ir0 < ir0_end; ++ir0) {
+                        vec_dot(ne00, &dst_col[ir0], 0, src0_row + ir0 * nb01, 0, src1_col, 0, 1);
+                    }
+                }
+            } else {
+                // for every 4x4, collect pr1[4], pr0[4]
+                const float32_t *pr1[4];
+                const float32_t *pr0[4];
+                float32_t *pdst[4];
+                for (int64_t ir1 = iir1; ir1 < iir1 + blck_1 && ir1 < ir1_end; ir1 += 1) {
+                    const int64_t i13 = (ir1 / (ne12 * ne1));
+                    const int64_t i12 = (ir1 - i13 * ne12 * ne1) / ne1;
+                    const int64_t i11 = (ir1 - i13 * ne12 * ne1 - i12 * ne1);
+
+                    // broadcast src0 into src1
+                    const int64_t i03 = i13 / r3;
+                    const int64_t i02 = i12 / r2;
+
+                    const int64_t i1 = i11;
+                    const int64_t i2 = i12;
+                    const int64_t i3 = i13;
+
+                    if (ir1 == iir1) {
+                        // Assert ir0 has same idx between ir1
+                        for (int64_t ir0 = iir0; ir0 < iir0 + blck_0 && ir0 < ir0_end; ++ir0) {
+                            const char * src0_row = (const char*)src0->data + (0 + i02 * nb02 + i03 * nb03);
+                            int64_t irb0 = ir0 - iir0;
+                            pr0[irb0] = (const float32_t*)(src0_row + ir0 * nb01);
+                        }
+                    }
+
+                    int64_t irb1 = ir1 - iir1;
+
+                    pr1[irb1] = (const float32_t*)(src1_cont ?
+                        ((const char*)wdata + (i11 + i12 * ne11 + i13 * ne12 * ne11) * row_size) :
+                        ((const char*)wdata + (i11 * nb11 + i12 * nb12 + i13 * nb13)));
+                    pdst[irb1] = (float*)((char*)dst->data + (i1 * nb1 + i2 * nb2 + i3 * nb3)) + iir0;
+                }
+                #if 0
+                // scalar check
+                for (int64_t ib1 = 0; ib1 < 4; ib1++) {
+                    for (int64_t ib0 = 0; ib0 < 4; ib0++) {
+                        pdst[ib1][ib0] = 0.0f;
+                        for (int64_t k = 0; k < ne00; k++) {
+                            pdst[ib1][ib0] += pr0[ib0][k] * pr1[ib1][k];
+                        }
+                    }
+                }
+                #else
+                svfloat32_t acc00 = svdup_f32(0.0f);
+                svfloat32_t acc01 = svdup_f32(0.0f);
+                svfloat32_t acc02 = svdup_f32(0.0f);
+                svfloat32_t acc03 = svdup_f32(0.0f);
+                svfloat32_t acc10 = svdup_f32(0.0f);
+                svfloat32_t acc11 = svdup_f32(0.0f);
+                svfloat32_t acc12 = svdup_f32(0.0f);
+                svfloat32_t acc13 = svdup_f32(0.0f);
+                svfloat32_t acc20 = svdup_f32(0.0f);
+                svfloat32_t acc21 = svdup_f32(0.0f);
+                svfloat32_t acc22 = svdup_f32(0.0f);
+                svfloat32_t acc23 = svdup_f32(0.0f);
+                svfloat32_t acc30 = svdup_f32(0.0f);
+                svfloat32_t acc31 = svdup_f32(0.0f);
+                svfloat32_t acc32 = svdup_f32(0.0f);
+                svfloat32_t acc33 = svdup_f32(0.0f);
+                size_t vl = svcntw();
+                for (int64_t k = 0; k < ne00; k += vl) {
+                    svbool_t pg = svwhilelt_b32(k, ne00);
+                    svfloat32_t v00 = svld1_f32(pg, &pr0[0][k]);
+                    svfloat32_t v01 = svld1_f32(pg, &pr0[1][k]);
+                    svfloat32_t v02 = svld1_f32(pg, &pr0[2][k]);
+                    svfloat32_t v03 = svld1_f32(pg, &pr0[3][k]);
+                    svfloat32_t v10 = svld1_f32(pg, &pr1[0][k]);
+                    svfloat32_t v11 = svld1_f32(pg, &pr1[1][k]);
+                    svfloat32_t v12 = svld1_f32(pg, &pr1[2][k]);
+                    svfloat32_t v13 = svld1_f32(pg, &pr1[3][k]);
+                    acc00 = svmla_f32_m(pg, acc00, v00, v10);
+                    acc01 = svmla_f32_m(pg, acc01, v00, v11);
+                    acc02 = svmla_f32_m(pg, acc02, v00, v12);
+                    acc03 = svmla_f32_m(pg, acc03, v00, v13);
+                    acc10 = svmla_f32_m(pg, acc10, v01, v10);
+                    acc11 = svmla_f32_m(pg, acc11, v01, v11);
+                    acc12 = svmla_f32_m(pg, acc12, v01, v12);
+                    acc13 = svmla_f32_m(pg, acc13, v01, v13);
+                    acc20 = svmla_f32_m(pg, acc20, v02, v10);
+                    acc21 = svmla_f32_m(pg, acc21, v02, v11);
+                    acc22 = svmla_f32_m(pg, acc22, v02, v12);
+                    acc23 = svmla_f32_m(pg, acc23, v02, v13);
+                    acc30 = svmla_f32_m(pg, acc30, v03, v10);
+                    acc31 = svmla_f32_m(pg, acc31, v03, v11);
+                    acc32 = svmla_f32_m(pg, acc32, v03, v12);
+                    acc33 = svmla_f32_m(pg, acc33, v03, v13);
+                }
+                svbool_t pg_all = svptrue_b32();
+                float32_t r00 = svaddv_f32(pg_all, acc00);
+                float32_t r01 = svaddv_f32(pg_all, acc01);
+                float32_t r02 = svaddv_f32(pg_all, acc02);
+                float32_t r03 = svaddv_f32(pg_all, acc03);
+                float32_t r10 = svaddv_f32(pg_all, acc10);
+                float32_t r11 = svaddv_f32(pg_all, acc11);
+                float32_t r12 = svaddv_f32(pg_all, acc12);
+                float32_t r13 = svaddv_f32(pg_all, acc13);
+                float32_t r20 = svaddv_f32(pg_all, acc20);
+                float32_t r21 = svaddv_f32(pg_all, acc21);
+                float32_t r22 = svaddv_f32(pg_all, acc22);
+                float32_t r23 = svaddv_f32(pg_all, acc23);
+                float32_t r30 = svaddv_f32(pg_all, acc30);
+                float32_t r31 = svaddv_f32(pg_all, acc31);
+                float32_t r32 = svaddv_f32(pg_all, acc32);
+                float32_t r33 = svaddv_f32(pg_all, acc33);
+                pdst[0][0] = r00;
+                pdst[1][0] = r01;
+                pdst[2][0] = r02;
+                pdst[3][0] = r03;
+                pdst[0][1] = r10;
+                pdst[1][1] = r11;
+                pdst[2][1] = r12;
+                pdst[3][1] = r13;
+                pdst[0][2] = r20;
+                pdst[1][2] = r21;
+                pdst[2][2] = r22;
+                pdst[3][2] = r23;
+                pdst[0][3] = r30;
+                pdst[1][3] = r31;
+                pdst[2][3] = r32;
+                pdst[3][3] = r33;
+                #endif
+            }
+        }
+    }
+}
