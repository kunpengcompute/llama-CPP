+//
+// fused_cpp SDPA helpers
+//
+
+static bool build_attn_mha_fused_sdpa_env_is(const char * value) {
+    const char * env = std::getenv("GGML_FUSED_CPP_SDPA");
+    return env != nullptr && strcmp(env, value) == 0;
+}
+
+bool llm_graph_context::build_attn_mha_use_fused_sdpa() const {
+#if defined(__aarch64__) || defined(_M_ARM64)
+    const char * env = std::getenv("GGML_FUSED_CPP_SDPA");
+    if (env == nullptr || env[0] == '\0') {
+        return true; // default enabled
+    }
+    return !build_attn_mha_fused_sdpa_env_is("0")     &&
+           !build_attn_mha_fused_sdpa_env_is("off")   &&
+           !build_attn_mha_fused_sdpa_env_is("false") &&
+           !build_attn_mha_fused_sdpa_env_is("no");
+#else
+    return false;
+#endif
+}
+
+bool llm_graph_context::build_attn_mha_fused_sdpa_debug() {
+    return build_attn_mha_fused_sdpa_env_is("debug") ||
+           build_attn_mha_fused_sdpa_env_is("trace");
+}
