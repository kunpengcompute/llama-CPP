+            "6:\n" // end of K loop
+
+            // Advance pa to next M block
+            "lsl x6, %[a_stride_bytes], #4\n add x3, x3, x6\n"
+
+            // ==== Convert accumulators from fp16 to fp32 and store ====
+            // We have 8 rows × 2 row groups = 16 rows total
+            // Accumulators: v16..v23 = row group 0 (rows 0-7), v24..v31 = row group 1 (rows 8-15)
+            // Each accumulator has 8 fp16 partial sums that need horizontal sum via fcvt + addv
+
+            // Convert and store row by row
+            // For each accumulator (8 fp16 values):
+            //   1. Convert to 2x fp32 vectors (fcvtl low, fcvtl2 high)
+            //   2. Sum each to scalar (addv)
+            //   3. Store the result
+
+            "lsl x5, x2, #2\n add x5, x5, %[C]\n"
+
+            // Each accumulator has 8 separate fp16 dot products (8 different A rows)
+            // Convert to fp32 and store as 8 separate output values
+            // acc v16 = rows 0-7 of group 0, acc v24 = rows 0-7 of group 1 (rows 8-15 total)
+#define STORE_ROW_GROUP(acc_lo, acc_hi, off)                           \
+            "fcvtl v0.4s, " #acc_lo ".4h\n"                            \
+            "fcvtl2 v1.4s, " #acc_lo ".8h\n"                           \
+            "fcvtl v2.4s, " #acc_hi ".4h\n"                            \
+            "fcvtl2 v3.4s, " #acc_hi ".8h\n"                           \
+            "stp q0, q1, [x5, #(0 + " #off ")]\n"                      \
+            "stp q2, q3, [x5, #(32 + " #off ")]\n"
+
+            STORE_ROW_GROUP(v16, v24, 0)
+            "add x5, x5, %[c_stride_bytes]\n"
+            STORE_ROW_GROUP(v17, v25, 0)
+            "add x5, x5, %[c_stride_bytes]\n"
+            STORE_ROW_GROUP(v18, v26, 0)
+            "add x5, x5, %[c_stride_bytes]\n"
+            STORE_ROW_GROUP(v19, v27, 0)
+            "add x5, x5, %[c_stride_bytes]\n"
+            STORE_ROW_GROUP(v20, v28, 0)
+            "add x5, x5, %[c_stride_bytes]\n"
+            STORE_ROW_GROUP(v21, v29, 0)
+            "add x5, x5, %[c_stride_bytes]\n"
+            STORE_ROW_GROUP(v22, v30, 0)
+            "add x5, x5, %[c_stride_bytes]\n"
+            STORE_ROW_GROUP(v23, v31, 0)
