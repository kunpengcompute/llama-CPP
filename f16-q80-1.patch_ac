+        C[(i + 3) * c_stride] = (float) svaddv_f16(pg, acc3);
+        C[(i + 4) * c_stride] = (float) svaddv_f16(pg, acc4);
+        C[(i + 5) * c_stride] = (float) svaddv_f16(pg, acc5);
