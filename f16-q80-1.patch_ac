+            svfloat16_t b3 = svld1_f16(pg, (const __fp16 *) &B[(i + 3) * K + k]);
+
+            acc0 = svmla_f16_m(pg, acc0, a0, b0);
+            acc1 = svmla_f16_m(pg, acc1, a0, b1);
+            acc2 = svmla_f16_m(pg, acc2, a0, b2);
+            acc3 = svmla_f16_m(pg, acc3, a0, b3);
