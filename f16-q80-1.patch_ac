+        k_nb3,
+        v_nb0,
+        v_nb1,
+        v_nb2,
+        v_nb3,
+        o_nb0,
+        o_nb1,
+        o_nb2,
+        o_nb3,
+        fp32_packqkv_sdpa::MaskF16Layout{
