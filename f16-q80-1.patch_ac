diff --git a/test_correctness.py b/test_correctness.py
new file mode 100644
index 00000000..18d14f8e
--- /dev/null
+++ b/test_correctness.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+import argparse
+import os
+import re
+import subprocess
+import sys
+
+import numpy as np
+
+REPO_ROOT = os.path.dirname(os.path.abspath(__file__))
+
+DEFAULT_BUILD1 = os.path.join(REPO_ROOT, "build")
+DEFAULT_BUILD2 = os.path.join(REPO_ROOT, "build-fused-sdpa")
+DEFAULT_MODEL = "/home/l00886679/models/bge-small-zh-v1.5-f16.gguf"
+DEFAULT_PROMPT = "Hello, world!"
+DEFAULT_THREADS = 1
+
+EMBEDDING_RE = re.compile(r"embedding\s+\d+:\s+(.*)$")
+
+
+def parse_embedding_output(text: str) -> np.ndarray:
+    for line in text.splitlines():
+        m = EMBEDDING_RE.search(line)
+        if m:
+            values = list(map(float, m.group(1).split()))
+            return np.array(values, dtype=np.float32)
+    raise ValueError(f"Could not parse embedding from output:\n{text}")
+
+
+def run_embedding(build_dir: str, model: str, prompt: str, threads: int,
+                  env_extras: dict | None = None) -> str:
+    bin_path = os.path.join(build_dir, "bin", "llama-embedding")
+    if not os.path.isfile(bin_path):
+        raise FileNotFoundError(f"llama-embedding not found at {bin_path}")
+
+    lib_dir = os.path.join(build_dir, "bin")
+    env = os.environ.copy()
+    env["LD_LIBRARY_PATH"] = f"/usr/local/lib:{lib_dir}"
+    if env_extras:
+        env.update(env_extras)
+
+    cmd = [
+        bin_path,
+        "-m", model,
+        "-p", prompt,
+        "-t", str(threads),
+    ]
+
+    result = subprocess.run(
+        cmd,
+        capture_output=True,
+        text=True,
+        timeout=120,
+        env=env,
+    )
+    if result.returncode != 0:
+        raise RuntimeError(
+            f"llama-embedding failed (exit={result.returncode}):\n"
+            f"stderr={result.stderr[:500]}"
+        )
+    return result.stdout
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--prompt", default=DEFAULT_PROMPT)
+    parser.add_argument("--build1", default=DEFAULT_BUILD1)
+    parser.add_argument("--build2", default=DEFAULT_BUILD2)
+    parser.add_argument("--model", default=DEFAULT_MODEL)
+    parser.add_argument("--threads", type=int, default=DEFAULT_THREADS)
+    parser.add_argument("--tolerance", type=float, default=1e-5)
+    parser.add_argument("--ggml-sdpa", type=int, default=None)
+    args = parser.parse_args()
+
+    print(f"Model:  {args.model}")
+    print(f"Prompt: {args.prompt!r}")
+    print(f"Threads: {args.threads}")
+    print(f"Tolerance: {args.tolerance}")
+    print()
+
+    print(f"[1/2] Running baseline ({args.build1}) ...")
+    sys.stdout.flush()
+    out1 = run_embedding(args.build1, args.model, args.prompt, args.threads)
+    ref = parse_embedding_output(out1)
+    print(f"      -> {len(ref)} dims")
+    print()
+
+    sdpa_env = {}
+    ggml_sdpa = args.ggml_sdpa if args.ggml_sdpa is not None else 1
+    sdpa_env["GGML_FUSED_CPP_SDPA"] = str(ggml_sdpa)
+    print(f"[2/2] Running fused-sdpa ({args.build2}) with GGML_FUSED_CPP_SDPA={ggml_sdpa} ...")
+    sys.stdout.flush()
+    out2 = run_embedding(args.build2, args.model, args.prompt, args.threads, env_extras=sdpa_env)
+    test = parse_embedding_output(out2)
+    print(f"      -> {len(test)} dims")
+    print()
+
+    cos_sim = float(np.dot(ref, test) / (np.linalg.norm(ref) * np.linalg.norm(test)))
+
+    diff = np.abs(ref - test)
+    max_err = float(np.max(diff))
+    mean_err = float(np.mean(diff))
+
+    print(f"Cosine similarity:  {cos_sim:.10f}")
+    print(f"Max absolute error: {max_err:.2e}")
+    print(f"Mean absolute error: {mean_err:.2e}")
+    print(f"Tolerance:          {args.tolerance:.2e}")
+    print()
+
+    if max_err < args.tolerance:
+        print(f"PASS: max error {max_err:.2e} < {args.tolerance:.2e}")
+        return 0
+    else:
+        print(f"FAIL: max error {max_err:.2e} >= {args.tolerance:.2e}")
+        worst_idx = int(np.argmax(diff))
+        print(f"  Worst element index: {worst_idx}")
+        print(f"  Reference value:     {ref[worst_idx]:.10f}")
+        print(f"  Test value:          {test[worst_idx]:.10f}")
+        return 1
+
+
